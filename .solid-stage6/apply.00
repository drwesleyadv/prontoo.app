from pathlib import Path
import re, shutil, sys
root=Path(sys.argv[1])

def read(p): return (root/p).read_text()
def write(p,s):
    p=root/p; p.parent.mkdir(parents=True,exist_ok=True); p.write_text(s)

# PHP 8.4 fixes already merged in stage5 branch.
p='app/Core/Architecture/CompatibilitySourceResolver.php'
s=read(p).replace("$root = rtrim(str_replace('\\\\', '/', $root), '/');", "$root = mb_rtrim(str_replace('\\\\', '/', $root), '/');")
s=s.replace("$relative = ltrim(str_replace('\\\\', '/', $relative), '/');", "$relative = mb_ltrim(str_replace('\\\\', '/', $relative), '/');")
s=s.replace("$class = ltrim((string) $class, '\\\\');", "$class = mb_ltrim((string) $class, '\\\\');")
s=s.replace("$file = rtrim($root, '/') . '/' . ltrim($path, '/');", "$file = mb_rtrim($root, '/') . '/' . mb_ltrim($path, '/');")
write(p,s)
p='tools/php84-runtime-contract-check'; s=read(p).replace('$runtimeHelper = $read("app/Support/Runtime.php");', '$runtimeHelper = $read("app/Infrastructure/Legacy/SupportRuntime/SupportRuntimeInfrastructureOperations01.php");').replace('"Helper interno não restringe a família PHP 8.4."','"Helper interno canônico não restringe a família PHP 8.4."'); write(p,s)

# Layer map: all Core native + role overrides for boundary/infrastructure components.
p='app/Core/Architecture/LayerMap.php'; s=read(p)
s=s.replace("        'app/Core/Architecture/',\n        'app/Core/Performance/',\n        'app/Core/Install/InstallAccess.php',\n        'app/Core/Database/SchemaMutationLock.php',\n        'app/Core/Database/SchemaHardening.php',", "        'app/Core/',")
s=s.replace("            $path === 'Core/Invariant/Request/ActionProof.php',\n            $path === 'Core/Architecture/ArchitectureVerifier.php',\n            $path === 'Core/Install/RuntimeContract.php',", "            $path === 'Core/Invariant/Request/ActionProof.php',\n            $path === 'Core/Architecture/ArchitectureVerifier.php',\n            $path === 'Core/Install/RuntimeContract.php',\n            $path === 'Core/Install/InstallAccess.php',\n            $path === 'Core/Database/SchemaMutationLock.php',")
# moved infrastructure integrity old paths remain empty core stubs, so no path overrides needed.
write(p,s)

# PdoActionProofStore must derive identity solely from passed context.
p='app/Infrastructure/Audit/PdoActionProofStore.php'; s=read(p)
s=s.replace("$context['user']['id'] ?? ($_SESSION['uid'] ?? null)", "$context['user']['id'] ?? null")
s=s.replace("(string) ($context['role'] ?? ($_SESSION['role_code'] ?? ''))", "(string) ($context['role'] ?? '')")
write(p,s)

# Move PiIntegrity to Infrastructure and make request context explicit/configurable.
old='app/Core/Integrity/PiIntegrity.php'; new='app/Infrastructure/Integrity/PiIntegrity.php'; s=read(old)
s=s.replace('namespace Prontoo\\Core\\Integrity;', 'namespace Prontoo\\Infrastructure\\Integrity;')
# add context property after class opening state block; locate first private static state.
s=s.replace("final class PiIntegrity\n{\n", "final class PiIntegrity\n{\n    private static array $runtimeContext = [];\n")
# Add configure method before activePrefix.
needle='    public static function activePrefix(): string\n'
method='''    public static function configureRuntimeContext(array $context): void\n    {\n        self::$runtimeContext = [\n            'route' => (string) ($context['route'] ?? ''),\n            'clinic_id' => (int) ($context['clinic_id'] ?? 0),\n            'user_id' => (int) ($context['user_id'] ?? 0),\n            'role' => (string) ($context['role'] ?? ''),\n        ];\n    }\n\n'''
s=s.replace(needle, method+needle,1)
s=s.replace("'route' => function_exists('route') ? (string) \\route() : (string) ($_GET['r'] ?? ''),", "'route' => (string) (self::$runtimeContext['route'] ?? ''),")
s=s.replace("'clinic_id' => self::sessionInt('clinic_id'),", "'clinic_id' => self::contextInt('clinic_id'),")
s=s.replace("'user_id' => self::sessionInt('uid'),", "'user_id' => self::contextInt('user_id'),")
s=s.