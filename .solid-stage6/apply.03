 0];\n        }\n        $clinicId = $scope === 'clinic' ? max(0, (int) ($runtime['clinic_id'] ?? 0)) : 0;\n        return [\n            'bypass' => $clinicId <= 0,\n            'reason' => $clinicId > 0 ? 'session_clinic_context' : 'no_clinic_context',\n            'clinic_id' => $clinicId,\n        ];\n    }\n}\n'''
