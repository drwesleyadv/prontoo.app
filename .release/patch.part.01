-    ): string {
-        $a = self::clean($action, "");
-        $id = max(
-            0,
-            (int) ($post["id"] ??
-                ($post["patient_id"] ??
-                    ($post["task_id"] ??
-                        ($post["document_id"] ??
-                            ($post["template_id"] ??
-                                ($post["notice_id"] ?? 0)))))),
-        );
-        $deleteLike = [
-            "delete",
-            "remove",
-            "deactivate",
-            "cancel",
-            "discard",
-            "archive",
-            "restore",
-        ];
-        foreach ($deleteLike as $needle) {
-            if (
-                $a === $needle ||
-                str_contains($a, $needle . "_") ||
-                str_contains($a, "_" . $needle)
-            ) {
-                return self::supported($module, "delete") ? "delete" : "edit";
-            }
-        }
-        $addLike = [
-            "add",
-            "new",
-            "create",
-            "store",
-            "register",
-            "emit",
-            "issue",
-        ];
-        foreach ($addLike as $needle) {
-            if (
-                $a === $needle ||
-                str_starts_with($a, $needle . "_") ||
-                str_contains($a, "_" . $needle)
-            ) {
-                return self::supported($module, "add") ? "add" : "edit";
-            }
-        }
-        if (
-            $id <= 0 &&
-            in_array(
-                $module,
-                [
-                    "leads",
-                    "appointments",
-                    "patients",
-                    "documents",
-                    "tasks",
-                    "notices",
-                    "users",
-                    "procedures",
-                    "financial",
