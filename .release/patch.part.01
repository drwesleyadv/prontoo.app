-                true,
-            )
-        ) {
-            return self::supported($module, "add") ? "add" : "edit";
-        }
-        return self::supported($module, "edit") ? "edit" : "view";
-    }
-    private static function isCashierFinancialAction(
-        string $route,
-        string $action,
-        array $ctx,
-    ): bool {
-        $a = self::clean($action, "");
-        if ($route !== "financial") {
-            return false;
-        }
-        if ((string) ($ctx["scope"] ?? "") !== "clinic") {
