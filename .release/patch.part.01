-            "operation" => $operation,
-            "scope" => $scope,
-            "role" => (string) ($ctx["role"] ?? ""),
-            "active_role" => (string) ($ctx["role"] ?? ""),
-            "clinic_id" => $ctx["clinic_id"] ?? null,
-            "proof_hash" => hash(
-                "sha256",
