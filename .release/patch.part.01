-                );
-            }
-            return false;
-        }
-        return $operation === "view" &&
-            isset(($ctx["allowed"] ?? [])[$module]);
-    }
-    private static function proofContext(
-        string $route,
-        ?string $module,
-        string $operation,
-        array $ctx,
