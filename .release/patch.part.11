-        return null;
-    }
-    q(
-        "INSERT INTO pi_user_agents (ua_hash,user_agent) VALUES (?,?) ON DUPLICATE KEY UPDATE id=LAST_INSERT_ID(id), user_agent=VALUES(user_agent)",
-        [hash("sha256", $ua . "|ua"), $ua],
-    );
-    return db_last_insert_id();
