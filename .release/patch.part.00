diff -ruN '--exclude=source-export.yml' prontoo_original/app/Core/Integrity/ActionProof.php prontoo_repo/app/Core/Integrity/ActionProof.php
--- prontoo_original/app/Core/Integrity/ActionProof.php	2026-07-20 20:56:54.000000000 +0000
+++ prontoo_repo/app/Core/Integrity/ActionProof.php	1970-01-01 00:00:00.000000000 +0000
@@ -1,446 +0,0 @@
-<?php
-declare(strict_types=1);
-namespace Prontoo\Core\Integrity;
-final class ActionProof
-{
-    private const POLICY_VERSION = "action-proof-v1";
-    private const PUBLIC_POST_ROUTES = [
-        "login",
-        "login_autotest",
-        "signup",
-        "logout",
-        "switch",
-        "profile",
-    ];
-    private const ROUTE_MODULES = [
-        "painel" => "painel",
-        "operations" => "operations",
-        "maestro" => "maestro",
-        "leads" => "leads",
-        "lead_lookup" => "leads",
-        "lead_patient_lookup" => "leads",
-        "appointments" => "appointments",
-        "patients" => "patients",
-        "patient" => "patients",
-        "patient_lookup" => "patients",
-        "patient_suggest" => "patients",
-        "documents" => "documents",
-        "document_view" => "documents",
-        "document_print" => "documents",
-        "document_pdf" => "documents",
-        "tasks" => "tasks",
-        "notices" => "notices",
-        "users" => "users",
-        "user" => "users",
-        "permissions" => "permissions",
-        "audit" => "audit",
-        "settings" => "settings",
-        "onboarding" => "settings",
-        "financial" => "financial",
-        "counterparty_lookup" => "financial",
-        "counterparty_suggest" => "financial",
-        "procedures" => "procedures",
-    ];
-    private function __construct() {}
-    public static function enforce(
-        string $route,
-        string $method,
-        array $post,
-        array $ctx,
-    ): void {
-        $route = self::clean($route, "login");
-        $method = strtoupper($method);
-        if ($method !== "POST") {
-            return;
-        }
-        if (in_array($route, self::PUBLIC_POST_ROUTES, true)) {
-            return;
-        }
-        if (!$ctx) {
-            self::deny(
-                "identidade_ausente",
-                $route,
-                null,
-                "view",
-                "Sessão autenticada ausente.",
-            );
-        }
-        $scope = (string) ($ctx["scope"] ?? "");
-        if ($scope === "global") {
-            if (!str_starts_with($route, "admin_")) {
-                self::deny(
-                    "escopo_global_incompativel",
-                    $route,
-                    null,
-                    "view",
-                    "Desenvolvedor tentou ação fora do escopo global.",
-                );
-            }
-            self::writeProof(
-                $route,
-                null,
-                "admin",
-                $ctx,
-                "global",
-                true,
-                "aprovada",
-            );
-            return;
-        }
-        if (
-            $scope !== "clinic" ||
-            (int) ($ctx["clinic_id"] ?? 0) <= 0 ||
-            (int) ($ctx["user"]["id"] ?? 0) <= 0
-        ) {
-            self::deny(
-                "escopo_clinica_invalido",
-                $route,
-                null,
-                "view",
-                "Escopo clínico autenticado ausente.",
-            );
-        }
-        $module = self::ROUTE_MODULES[$route] ?? null;
-        if ($module === null) {
-            self::deny(
-                "rota_sem_capacidade",
-                $route,
-                null,
-                "view",
-                "Rota protegida sem contrato explícito de capacidade.",
-            );
-        }
-        $operation = self::operationFor($post);
-        $role = (string) ($ctx["role"] ?? "");
-        $allowed = false;
-        if ($role === "gerente") {
-            $allowed = true;
-        } elseif (function_exists("can")) {
-            $allowed = can($ctx, $module, $operation);
-        } elseif (function_exists("module_allowed")) {
-            $allowed = module_allowed($ctx, $module);
-        }
-        self::writeProof(
-            $route,
-            $module,
-            $operation,
-            $ctx,
-            "clinic",
-            $allowed,
-            $allowed ? "aprovada" : "capacidade_ausente",
-        );
-        if (!$allowed) {
-            self::deny(
-                "capacidade_ausente",
-                $route,
-                $module,
-                $operation,
-                "Ação recusada pela matriz de capacidades.",
-            );
-        }
-    }
-    private static function operationFor(array $post): string
-    {
-        $act = self::clean((string) ($post["act"] ?? ""), "");
-        if ($act === "") {
-            return "view";
-        }
-        foreach (
-            [
-                "create",
-                "new",
-                "save",
-                "add",
-                "invite",
-                "convert",
-                "generate",
-                "issue",
-            ]
-            as $needle
-        ) {
-            if (str_contains($act, $needle)) {
-                return "add";
-            }
-        }
-        if (str_contains($act, "delete") || str_contains($act, "remove")) {
-            return "delete";
-        }
-        return "edit";
-    }
-    private static function writeProof(
-        string $route,
-        ?string $module,
-        string $operation,
-        array $ctx,
-        string $scope,
-        bool $allowed,
-        string $reason,
-    ): void {
-        if (!function_exists("q") || !function_exists("db_table_exists")) {
-            return;
-        }
-        try {
-            if (!db_table_exists("pi_action_proofs")) {
-                return;
-            }
-            $clinicId = (int) ($ctx["clinic_id"] ?? 0);
-            $userId = (int) ($ctx["user"]["id"] ?? 0);
-            $role = (string) ($ctx["role"] ?? "");
-            $context = [
-                "route" => $route,
-                "module" => $module,
-                "operation" => $operation,
-                "scope" => $scope,
-                "clinic_id" => $clinicId,
-                "user_id" => $userId,
-                "role" => $role,
-                "allowed" => $allowed,
-                "reason" => $reason,
-                "policy" => self::POLICY_VERSION,
-                "ts" => time(),
-            ];
-            $json = self::canonicalJson($context);
-            $hash = hash("sha256", $json);
-            q(
-                "INSERT INTO pi_action_proofs (clinic_id,user_id,route,module_key,operation_key,scope,role_code,allowed,reason,proof_hash,policy_version,context_json,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)",
-                [
-                    $clinicId > 0 ? $clinicId : null,
-                    $userId > 0 ? $userId : null,
-                    mb_substr($route, 0, 80),
-                    $module !== null ? mb_substr($module, 0, 80) : null,
-                    mb_substr($operation, 0, 20),
-                    mb_substr($scope, 0, 20),
-                    $role !== "" ? mb_substr($role, 0, 40) : null,
-                    $allowed ? 1 : 0,
-                    mb_substr($reason, 0, 180),
-                    $hash,
-                    self::POLICY_VERSION,
-                    $json,
-                    time(),
-                ],
-            );
-        } catch (\Throwable $e) {
-            error_log("[Prontoo action proof] " . $e->getMessage());
-        }
-    }
-    private static function deny(
-        string $reason,
-        string $route,
-        ?string $module,
-        string $operation,
-        string $message,
-    ): never {
-        $details = [
-            "reason" => $reason,
-            "route" => $route,
-            "module" => $module,
-            "operation" => $operation,
-        ];
-        error_log(
-            "[Prontoo action denied] " .
-                json_encode(
-                    $details,
-                    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES,
-                ),
-        );
-        if (class_exists("ProntooHttpError")) {
-            throw new \ProntooHttpError(
-                403,
-                "Esta ação não está disponível para o seu acesso atual.",
-            );
-        }
-        throw new \RuntimeException($message);
-    }
-    private static function clean(string $value, string $fallback): string
-    {
-        $value = strtolower(trim($value));
-        $value = preg_replace("/[^a-z0-9_-]/", "", $value) ?? "";
-        return $value !== "" ? $value : $fallback;
-    }
-    private static function canonicalJson(array $payload): string
-    {
-        $payload = self::sortRecursive($payload);
