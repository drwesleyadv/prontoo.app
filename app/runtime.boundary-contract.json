{
    "schema": "prontoo-runtime-boundary-contract-v1",
    "policy": "runtime_debt_is_tokenized_inventoried_and_may_only_decrease_until_semantic_closure",
    "runtime_root": "app/Runtime",
    "baseline_file": "app/runtime.boundary-baseline.json",
    "composition_roots": {
        "app/Runtime/LayeredKernel.php": "wires the authorization service and its infrastructure proof store",
        "app/Runtime/Patients/PatientComposition.php": "wires patient application services to PDO repositories",
        "app/Runtime/Financial/FinancialComposition.php": "wires financial application services to PDO repositories",
        "app/Runtime/SecurityAccess/SecurityAccessComposition.php": "wires security application ports to the persistence adapter",
        "app/Runtime/Operational/OperationalComposition.php": "wires scoped operational use cases to the PDO catalog repository"
    },
    "structural_sql_exceptions": {
        "app/Runtime/DatabaseSchema/DatabaseSchemaRuntimeOperations01.php": "frozen compatibility execution boundary for schema readiness and guarded query dispatch; still counted as structural debt and not authorized to grow"
    },
    "persistence_helpers": {
        "Prontoo\\Runtime\\DatabaseSchema\\DatabaseSchemaRuntimeOperations01": [
            "q",
            "one",
            "val"
        ],
        "Prontoo\\Runtime\\SecurityAccess\\SecurityAccessRuntimeOperations01": [
            "safe_val",
            "cached_val"
        ]
    },
    "persistence_helper_method_patterns": [
        "^db_(?:tx|last_insert_id|table_exists|column_exists)$",
        "^(?:safe_db_columns|install_fresh_schema)$",
        "^(?:ensure_[a-z0-9_]+_schema|[a-z0-9_]+_ensure_schema)$",
        "^schema_(?:apply|cleanup)_[a-z0-9_]+$"
    ],
    "transaction_methods": [
        "beginTransaction",
        "commit",
        "rollBack",
        "db_tx",
        "db_begin_transaction",
        "db_commit",
        "db_rollback"
    ],
    "required_zero_categories": [
        "runtime_business_sql",
        "runtime_direct_pdo",
        "runtime_repository_instantiation_outside_composition",
        "runtime_transaction_orchestration_business"
    ],
    "path_zero_rules": [
        {
            "id": "runtime_operational_semantic_closure",
            "path_prefix": "app/Runtime/",
            "categories": [
                "runtime_business_sql",
                "runtime_direct_pdo",
                "runtime_repository_instantiation_outside_composition",
                "runtime_transaction_orchestration_business"
            ]
        },
        {
            "id": "financial_semantic_closure",
            "path_prefix": "app/Runtime/Financial/",
            "categories": [
                "runtime_business_sql",
                "runtime_structural_sql",
                "runtime_direct_pdo",
                "runtime_persistence_helper",
                "runtime_repository_instantiation_outside_composition",
                "runtime_transaction_orchestration_business",
                "runtime_transaction_orchestration_structural"
            ]
        },
        {
            "id": "security_access_semantic_closure",
            "path_prefix": "app/Runtime/SecurityAccess/",
            "categories": [
                "runtime_business_sql",
                "runtime_structural_sql",
                "runtime_direct_pdo",
                "runtime_persistence_helper",
                "runtime_repository_instantiation_outside_composition",
                "runtime_transaction_orchestration_business",
                "runtime_transaction_orchestration_structural"
            ]
        },
        {
            "id": "auth_onboarding_semantic_closure",
            "path_prefix": "app/Runtime/AuthOnboarding/",
            "categories": [
                "runtime_business_sql",
                "runtime_structural_sql",
                "runtime_direct_pdo",
                "runtime_persistence_helper",
                "runtime_repository_instantiation_outside_composition",
                "runtime_transaction_orchestration_business",
                "runtime_transaction_orchestration_structural"
            ]
        },
        {
            "id": "users_permissions_semantic_closure",
            "path_prefix": "app/Runtime/UsersPermissions/",
            "categories": [
                "runtime_business_sql",
                "runtime_structural_sql",
                "runtime_direct_pdo",
                "runtime_persistence_helper",
                "runtime_repository_instantiation_outside_composition",
                "runtime_transaction_orchestration_business",
                "runtime_transaction_orchestration_structural"
            ]
        }
    ]
}
