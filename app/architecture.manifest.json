{
  "version": "1.7.23.6",
  "policy": "php-layered-invariants-v2",
  "architecture": "layered_php_with_invariant_core",
  "coverage_scope": "all_versioned_php_files_excluding_ssd_vendor_node_modules_and_git",
  "classification_coverage_target_percent": 100,
  "native_files_min": 13,
  "transitional_files_max": 78,
  "native_migration_policy": "native_file_count_must_not_decrease_and_transitional_file_count_must_not_increase",
  "layers": {
    "core": "pure canonical decisions, mutation invariants, tenant isolation, workflows and integrity",
    "domain": "business contracts independent from HTTP and persistence",
    "application": "use cases and ports",
    "infrastructure": "PDO, live credential resolution, runtime permission matrix and external adapters",
    "presentation": "HTTP and UI adapters",
    "composition": "dependency wiring, runtime bootstrap and transitional thin boundaries"
  },
  "dependency_rule": "dependencies_point_inward_and_composition_is_the_only_layer_that_may_wire_all_layers",
  "authorization_entrypoint": "Prontoo\\Runtime\\LayeredKernel::enforceAction",
  "mutation_entrypoint": "Prontoo\\Core\\Invariant\\InvariantKernel::guardMutation",
  "credential_policy": "every_protected_post_revalidates_active_user_clinic_and_roles_or_global_admin_status_from_the_database",
  "proof_policy": "an_allowed_mutation_and_its_mutation_proof_commit_in_the_same_transaction_or_both_roll_back",
  "audit_chain_policy": "linked_hmac_chain_with_transactional_head_anchor_and_fail_closed_verification",
  "financial_integrity_policy": "integer_cents_canonical_topology_compensating_adjustments_and_reconciled_daily_snapshots",
  "temporal_partition_policy": "civil_month_and_day_boundaries_follow_the_clinic_timezone_and_are_queried_as_half_open_utc_ranges",
  "estimator_policy": "ewma_updates_only_from_real_observations_and_skips_preserve_the_previous_estimate",
  "mathematical_property_ci": ".github/workflows/architecture.yml",
  "action_audit_policy": "action_literals_are_matched_against_contracts_declared_for_the_same_source_file",
  "architecture_check": "tools/architecture-check.php",
  "ci_workflow": ".github/workflows/architecture.yml",
  "removed_legacy_files": [
    "app/Core/Invariant/ActionCapabilityCatalog.php",
    "app/Core/Invariant/CapabilityInvariant.php",
    "app/Core/Integrity/PiSequence.php",
    "app/Core/Integrity/ActionProof.php",
    "app/Infrastructure/Database/CleanInstallReset.php"
  ],
  "compatibility_boundaries": [
    {
      "symbol": "enforce_action_integrity",
      "file": "app/Support/SecurityAccess.php",
      "rule": "thin delegation only; no authorization or persistence logic"
    },
    {
      "symbol": "Prontoo\\Core\\Integrity\\ActionProof",
      "file": "app/Core/Invariant/Request/ActionProof.php",
      "rule": "thin delegation to LayeredKernel only"
    }
  ],
  "database_changes": false,
  "schema_changes": false,
  "visual_changes": true,
  "runtime_profile_policy": "environment_php_excluded_and_repository_migration_metrics_non_fatal_at_boot",
  "database_architecture": "clean_schema_with_native_seq_and_layer2_action_ledger",
  "sequence_policy": "every_table_generates_non_null_unique_Seq_with_UUID_SHORT_default_no_sequence_table",
  "support_record_policy": "one_action_ledger_row_per_protected_action_and_inline_audit_dimensions",
  "clean_install_policy": "existing_prontoo_r6_database_is_dropped_after_safety_checks_and_installer_requires_zero_tables",
  "installer_access_policy": "http_disabled_after_commissioning_github_actions_cli_certification_only",
  "schema_mutation_policy": "runtime_frozen_github_actions_cli_four_markers_only",
  "destructive_reset_policy": "removed_from_runtime",
  "runtime_loading_policy": "route_loaded_installer_local_only_no_historical_cleanup_on_hot_path",
  "json_cache_policy": "get_only_scoped_tag_invalidated_stable_lookup_cache",
  "authorization_scope_check": "ActionCatalog::logicSelfTest + RuntimeCapabilityProvider::logicSelfTest + .github/workflows/architecture.yml",
  "authorization_action_policy": "every_protected_post_uses_an_explicit_exact_action_contract_and_unknown_actions_fail_closed",
  "documentation_policy": "ChangeLog.txt_and_in_source_function_guides_only_no_markdown_files",
  "function_documentation_units": 1931,
  "function_documentation_named": 1704,
  "function_documentation_closures": 127,
  "function_documentation_arrows": 100,
  "function_documentation_ci": ".github/workflows/architecture.yml",
  "logic_changes": true,
  "authentication_policy": "password_plus_mfa_for_developer_no_persistent_device_idle_3600_seconds_per_user_session_generation",
  "privileged_elevation_policy": "fresh_password_and_mfa_required_for_global_scope",
  "commissioned_installation_lockdown": {
    "http": "denied_at_webserver_and_php_entry",
    "runtime_redirect": false,
    "localhost_bypass": false,
    "public_window": false,
    "schema_mutation": "github-actions-cli-four-markers-only",
    "developer_panel_icon": "network_ping"
  }
}
