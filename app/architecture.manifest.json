{
  "version": "1.7.20.4",
  "policy": "php-layered-invariants-v2",
  "architecture": "layered_php_with_invariant_core",
  "coverage_scope": "all_versioned_php_files_excluding_storage_vendor_node_modules_and_git",
  "classification_coverage_target_percent": 100,
  "native_files_min": 11,
  "transitional_files_max": 79,
  "native_migration_policy": "native_file_count_must_not_decrease_and_transitional_file_count_must_not_increase",
  "layers": {
    "core": "pure canonical decisions, mutation invariants, tenant isolation, workflows and integrity",
    "domain": "business contracts independent from HTTP and persistence",
    "application": "use cases and ports",
    "infrastructure": "PDO, live credential resolution, runtime permission matrix and external adapters",
    "presentation": "HTTP and UI adapters",
    "composition": "dependency wiring, runtime bootstrap and transitional thin boundaries"
  },
  "dependency_rule": "dependencies_point_inward_and_composition_is_the_only_layer_that_may_wire_all_layers",
  "authorization_entrypoint": "Prontoo\\Runtime\\LayeredKernel::enforceAction",
  "mutation_entrypoint": "Prontoo\\Core\\Invariant\\InvariantKernel::guardMutation",
  "credential_policy": "every_protected_post_revalidates_active_user_clinic_and_roles_or_global_admin_status_from_the_database",
  "proof_policy": "an_allowed_mutation_fails_closed_when_its_authorization_proof_cannot_be_persisted",
  "action_audit_policy": "action_literals_are_matched_against_contracts_declared_for_the_same_source_file",
  "architecture_check": "tools/architecture-check.php",
  "ci_workflow": ".github/workflows/architecture.yml",
  "removed_legacy_files": [
    "app/Core/Invariant/ActionCapabilityCatalog.php",
    "app/Core/Invariant/CapabilityInvariant.php"
  ],
  "compatibility_boundaries": [
    {
      "symbol": "enforce_action_integrity",
      "file": "app/Support/SecurityAccess.php",
      "rule": "thin delegation only; no authorization or persistence logic"
    },
    {
      "symbol": "Prontoo\\Core\\Integrity\\ActionProof",
      "file": "app/Core/Invariant/Request/ActionProof.php",
      "rule": "thin delegation to LayeredKernel only"
    }
  ],
  "database_changes": false,
  "schema_changes": false,
  "visual_changes": false
}
