path = 'app/Core/Architecture/ArchitectureVerifier.php'


source = read(path)


source = source.replace(
    'public static function report(string $root, bool $strictActions = false): array',
    'public static function report(\n        string $root,\n        bool $strictActions = false,\n        array $runtimeModules = [],\n        array $routes = [],\n    ): array',
    1,
)


old = '''        $cacheKey = $root . '|' . ($strictActions ? 'strict' : 'runtime');'''


new = '''        $runtimeModules = array_values(array_unique(array_map('strval', $runtimeModules)));
        $routes = array_values(array_unique(array_map('strval', $routes)));
        $cacheKey = $root . '|' .
            ($strictActions ? 'strict' : 'runtime') . '|' .
            hash('sha256', serialize([$runtimeModules, $routes]));'''


if old not in source:
    raise SystemExit(f'expected verifier cache key not found: {path}')


source = source.replace(old, new, 1)


