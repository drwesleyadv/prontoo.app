for method, next_method in [
    ('patient_tab_icon_picker', 'patient_guardian_relationship_options'),
    ('patient_appointment_registration_block_reason', 'patient_directory_filter_options'),
]:
    start = source.find(f'    public static function {method}(')
    end = source.find(f'    public static function {next_method}(', start)
    if start < 0 or end < 0:
        raise SystemExit(f'expected patient Domain method bounds not found: {method}')
    source = source[:start] + source[end:]


write(path, source)


