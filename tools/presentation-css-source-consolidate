def fail(message: str) -> None:
    raise SystemExit(message)


def write_text(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")


def replace_exact(path: Path, old: str, new: str, minimum: int = 1) -> None:
    source = path.read_text(encoding="utf-8")
    count = source.count(old)
    if count < minimum:
        fail(f"expected replacement missing: {path} {old}")
    path.write_text(source.replace(old, new), encoding="utf-8")


def split_units(source: str) -> list[str]:
    boundaries: list[int] = []
    depth = 0
    in_string: str | None = None
    in_comment = False
    escaped = False
    i = 0
    length = len(source)
    while i < length:
        ch = source[i]
        nxt = source[i + 1] if i + 1 < length else ""
        if in_comment:
            if ch == "*" and nxt == "/":
                in_comment = False
                i += 2
                continue
            i += 1
            continue
        if in_string is not None:
            if escaped:
                escaped = False
            elif ch == "\\":
                escaped = True
            elif ch == in_string:
                in_string = None
            i += 1
            continue
        if ch == "/" and nxt == "*":
            in_comment = True
            i += 2
            continue
        if ch in ("'", '"'):
            in_string = ch
            i += 1
            continue
        if ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth < 0:
                fail("unbalanced CSS closing brace")
            if depth == 0:
                boundaries.append(i + 1)
        elif ch == ";" and depth == 0:
            boundaries.append(i + 1)
        i += 1
    if depth != 0 or in_comment or in_string is not None:
        fail("unbalanced CSS source")
    units: list[str] = []
    start = 0
    for end in boundaries:
        if end > start:
            units.append(source[start:end])
            start = end
    if start < len(source):
        if units:
            units[-1] += source[start:]
        else:
            units.append(source[start:])
    if "".join(units) != source:
        fail("CSS unit split changed source")
    return units


def concerns(chunk: str) -> list[str]:
    lower = chunk.lower()
    found: list[str] = []
    if "--md-" in lower or "--pt-" in lower or "--clinic-" in lower:
        found.append("tokens")
    if "body[data-route=" in lower or "[data-route=" in lower:
        found.append("routes")
    if any(token in lower for token in ("is-read-only", "is-disabled", ":disabled", "[disabled]", "aria-disabled", "--danger", ".danger", ".warning")):
        found.append("states")
    if any(token in lower for token in ("pagehead", "modal", "dialog", "card", "chip", "button", "toolbar", "sidebar", "table", "field", "toast", "drawer", "tabs", "kpi", "search")):
        found.append("components")
    if any(token in lower for token in ("display:grid", "display:flex", "grid-template", ".stack", ".cluster", ".layout", ".columns")):
        found.append("patterns")
    if any(token in lower for token in ("material-symbols", "spinner", "skeleton", ".icon", ".badge")):
        found.append("primitives")
    if any(token in lower for token in ("sr-only", "visually-hidden", ".hidden", ".nowrap", ".u-")):
        found.append("utilities")
    if any(token in lower for token in ("html{", "body{", "*{", "@import", "@font-face")):
        found.append("foundation")
    if not found:
        found.append("components")
    order = ["tokens", "foundation", "primitives", "components", "patterns", "routes", "utilities", "states"]
    return [name for name in order if name in found]


def primary_layer(chunk: str, index: int) -> tuple[str, list[str]]:
    detected = concerns(chunk)
    route_count = chunk.count("body[data-route=") + chunk.count("[data-route=")
    if index == 1 and "tokens" in detected:
        return "tokens", detected
    if route_count >= 3:
        return "routes", detected
    if "states" in detected and "routes" not in detected:
        return "states", detected
    if "foundation" in detected and index <= 2:
        return "foundation", detected
    if "patterns" in detected and "components" not in detected:
        return "patterns", detected
    if "primitives" in detected and "components" not in detected:
        return "primitives", detected
    if "utilities" in detected and len(detected) == 1:
        return "utilities", detected
    return "components", detected


