<?php
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

$root = dirname(__DIR__);
require_once $root . '/app/Core/Architecture/LayerMap.php';
$runtime = $root . '/app/Runtime';
$contract = json_decode(
    (string) file_get_contents($root . '/app/runtime.boundary-contract.json'),
    true,
    512,
    JSON_THROW_ON_ERROR,
);
if (!is_array($contract) || ($contract['schema'] ?? '') !== 'prontoo-runtime-boundary-contract-v1') {
    throw new RuntimeException('Contrato da fronteira Runtime inválido.');
}
$allowed = array_keys((array) ($contract['composition_roots'] ?? []));
$violations = [];
$declaredRoots = \Prontoo\Core\Architecture\LayerMap::compositionRoots();
if ($allowed !== $declaredRoots) {
    $violations[] = 'composition_root_contract_drift';
}
$instantiations = [];
$iterator = new RecursiveIteratorIterator(
    new RecursiveDirectoryIterator($runtime, FilesystemIterator::SKIP_DOTS),
);
foreach ($iterator as $file) {
    if (!$file instanceof SplFileInfo || !$file->isFile() || strtolower($file->getExtension()) !== 'php') {
        continue;
    }
    $absolute = str_replace('\\', '/', $file->getPathname());
    $relative = 'app/Runtime/' . ltrim(str_replace(str_replace('\\', '/', $runtime), '', $absolute), '/');
    $tokens = token_get_all((string) file_get_contents($absolute));
    $code = '';
    foreach ($tokens as $token) {
        if (is_array($token) && in_array($token[0], [T_COMMENT, T_DOC_COMMENT, T_CONSTANT_ENCAPSED_STRING, T_ENCAPSED_AND_WHITESPACE], true)) {
            $code .= str_repeat(' ', strlen($token[1]));
            continue;
        }
        $code .= is_array($token) ? $token[1] : $token;
    }
    $count = preg_match_all('~\bnew\s+(?:\\\\?Prontoo\\\\Infrastructure\\\\[A-Za-z0-9_\\\\]+|Pdo[A-Z][A-Za-z0-9_]*)~', $code, $matches);
    if ($count <= 0) {
        continue;
    }
    $instantiations[$relative] = $count;
    if (!in_array($relative, $allowed, true)) {
        $violations[] = $relative;
    }
}
sort($violations, SORT_STRING);
ksort($instantiations, SORT_STRING);
$result = [
    'ok' => $violations === [],
    'policy' => 'runtime-concrete-adapters-only-in-composition-roots-v1',
    'allowed_roots' => $allowed,
    'runtime_files_with_concrete_adapter_instantiation' => $instantiations,
    'violations' => $violations,
];
fwrite(STDOUT, json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . PHP_EOL);
exit($violations === [] ? 0 : 1);
