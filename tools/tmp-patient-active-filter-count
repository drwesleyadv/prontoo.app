#!/usr/bin/env bash
set -euo pipefail

python3 <<'PY'
from pathlib import Path

p = Path('public/assets/app.js')
text = p.read_text()

old = '''      let initial = box.innerHTML,
        timer = null,
        seq = 0;'''
new = '''      $$(".patient-directory-result-count", box).forEach((node) => node.remove());
      let initial = box.innerHTML,
        initialCount = $$("[data-patient-row]", box).length,
        timer = null,
        seq = 0;'''
if text.count(old) != 1:
    raise SystemExit('app.js initial block mismatch')
text = text.replace(old, new, 1)

old = '''      const foundChip = (count) =>
        '<span class="patient-filter-chip active is-active patient-filter-found" aria-current="page"><span class="material-symbols-rounded" aria-hidden="true">manage_search</span><span>Encontrados</span><small>' +
        String(Math.max(0, Number(count) || 0)) +
        "</small></span>";
      const syncFound = (q, count) => {
        if (!chips) return;
        if (!q) {
          chips.innerHTML = baseChips;
          return;
        }
        chips.innerHTML = foundChip(count) + baseChips;
      };'''
new = '''      const normalizedCount = (count) =>
        Math.max(0, Number(count) || 0);
      const syncActiveFilterCount = (count) => {
        if (!chips) return;
        const active = $(
          ".patient-filter-chip.active:not(.patient-filter-found)",
          chips,
        );
        if (!active) return;
        const label = $$("span", active).find(
          (node) => !node.classList.contains("material-symbols-rounded"),
        );
        if (!label) return;
        const base =
          active.dataset.patientFilterLabel ||
          String(label.textContent || "")
            .replace(/\\s*\\(\\d+\\)\\s*$/, "")
            .trim();
        active.dataset.patientFilterLabel = base;
        label.textContent = `${base} (${normalizedCount(count)})`;
      };
      const foundChip = (count) =>
        '<span class="patient-filter-chip active is-active patient-filter-found" aria-current="page"><span class="material-symbols-rounded" aria-hidden="true">manage_search</span><span>Encontrados (' +
        String(normalizedCount(count)) +
        ")</span></span>";
      const syncFound = (q, count) => {
        if (!chips) return;
        if (!q) {
          chips.innerHTML = baseChips;
          syncActiveFilterCount(initialCount);
          return;
        }
        chips.innerHTML = foundChip(count) + baseChips;
      };
      syncActiveFilterCount(initialCount);'''
if text.count(old) != 1:
    raise SystemExit('app.js found chip block mismatch')
text = text.replace(old, new, 1)
p.write_text(text)

css = Path('design/styles/application.css')
c = css.read_text()
rule = '\n.patient-directory-result-count{display:none}\n'
if '.patient-directory-result-count{display:none}' not in c:
    c = c.rstrip() + rule
css.write_text(c)
PY

cat > /tmp/release.json <<'JSON'
{
  "build": "1.9.14.5-patient-active-filter-count",
  "package_type": "micro_ux",
  "notes": "Move a contagem de registros da base da listagem para o título do filtro ativo na tela de Pacientes, preservando consultas, permissões e schema.",
  "logic_changes": true,
  "visual_changes": true,
  "documentation_changes": true,
  "changelog": {
    "title": "Contagem integrada ao filtro ativo de Pacientes",
    "items": [
      "Remove a informação N encontrados. do rodapé direito da listagem de Pacientes.",
      "Exibe o total recuperado diretamente no título do filtro ativo no formato Nome (N).",
      "Mantém a contagem sincronizada ao restaurar o filtro após uma busca dinâmica.",
      "Normaliza o chip de busca para Encontrados (N), sem badge numérico separado.",
      "Preserva as regras de acesso do filtro Todos e todos os critérios de consulta existentes.",
      "Não altera schema, persistência ou limites dos filtros existentes."
    ]
  }
}
JSON

STAMP="$(TZ=America/Cuiaba date --iso-8601=seconds)"
php tools/release-version --write --date=2026-09-14 --timestamp="$STAMP" --expected-current=1.9.14.4 --metadata-file=/tmp/release.json

git mv public/assets/app-icon-1.9.14.4.png public/assets/app-icon-1.9.14.5.png
git mv public/assets/favicon-1.9.14.4.ico public/assets/favicon-1.9.14.5.ico
git mv public/assets/favicon-1.9.14.4.png public/assets/favicon-1.9.14.5.png
git mv public/assets/pix-1.9.14.4.svg public/assets/pix-1.9.14.5.svg
git mv public/assets/prontoo-mark-1.9.14.4.png public/assets/prontoo-mark-1.9.14.5.png

python3 <<'PY'
import subprocess
from pathlib import Path
for raw in subprocess.check_output(['git', 'grep', '-Ilz', '1.9.14.4']).split(b'\0'):
    if not raw:
        continue
    p = Path(raw.decode())
    try:
        text = p.read_text()
    except UnicodeDecodeError:
        continue
    if '1.9.14.4' in text:
        p.write_text(text.replace('1.9.14.4', '1.9.14.5'))
PY

php tools/presentation-css-build --lint
php tools/presentation-css-build --write
php tools/presentation-css-build --check

git rm .github/workflows/tmp-patient-active-filter-count.yml tools/tmp-patient-active-filter-count
php tools/release-contract-reconcile --write
php tools/release-contract-reconcile --check
php tools/release-version
php tools/version-asset-contract-check.php
php tools/superseded-reference-contract-check
php tools/test-fast
node --check public/assets/app.js
grep -Fq '.patient-directory-result-count{display:none}' design/styles/application.css
grep -Fq 'label.textContent = `${base} (${normalizedCount(count)})`;' public/assets/app.js
grep -Fq '<span>Encontrados (' public/assets/app.js
git diff --check

git config user.name 'github-actions[bot]'
git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
git add -A
git commit -m 'Move contagem para o filtro ativo de Pacientes'
git push origin HEAD:feature/patient-active-filter-count-1-9-14-5
