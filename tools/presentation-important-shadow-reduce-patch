#!/usr/bin/env python3
from pathlib import Path

path = Path('tools/presentation-important-shadow-reduce')
source = path.read_text(encoding='utf-8')
source = source.replace("    previous['shadowed_identical_important_declarations'] = 141\n", '')
source = source.replace("    final['shadowed_identical_important_declarations'] = 0\n", '')
source = source.replace("    visual['debt_budget']['shadowed_identical_important_declarations'] = 0\n", '')
anchor = "    visual['delivery']['current_sha256'] = current_sha\n"
proof = "    visual.setdefault('proofs', {})['important_shadow_reduction'] = {\n        'policy': 'earlier_identical_important_same_context_selector_property_value_is_inert_when_later_reassertion_exists',\n        'formal_candidates_before': 141,\n        'formal_candidates_removed': 141,\n        'distinct_reasserted_keys': 133,\n        'unparsed_historical_important_occurrences_preserved': 17,\n    }\n"
if source.count(anchor) != 1:
    raise SystemExit('delivery anchor missing')
source = source.replace(anchor, proof + anchor, 1)
path.write_text(source, encoding='utf-8')
