<?php
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit(1);
}

$root = dirname(__DIR__);
$baselinePath = $root . '/app/presentation.ux-baseline.json';
$fixturePath = $root . '/tests/presentation/ux-fixture.html';
$runnerPath = $root . '/tools/presentation-ux-contract.mjs';
$workflowPath = $root . '/.github/workflows/presentation-ux.yml';
$failures = [];

foreach ([$baselinePath, $fixturePath, $runnerPath, $workflowPath] as $path) {
    if (!is_file($path)) {
        $failures[] = 'missing:' . str_replace($root . '/', '', $path);
    }
}

$baseline = [];
if (is_file($baselinePath)) {
    try {
        $decoded = json_decode((string) file_get_contents($baselinePath), true, 512, JSON_THROW_ON_ERROR);
        if (is_array($decoded)) {
            $baseline = $decoded;
        } else {
            $failures[] = 'baseline:not_object';
        }
    } catch (Throwable $error) {
        $failures[] = 'baseline:invalid_json';
    }
}

$expectedScenarios = [
    'desktop', 'appointments', 'readonly', 'primary-hover', 'mobile', 'mobile-appointments',
    'financial', 'mobile-financial', 'patient', 'mobile-patient', 'procedures', 'mobile-procedures',
];
$expectedTargets = [
    'topbar', 'cmdbar', 'pagehead', 'nav-group', 'nav-idle', 'nav-active', 'primary', 'secondary', 'danger',
    'grid', 'card', 'stat', 'form-card', 'field', 'input', 'form-actions', 'feedback', 'pill',
    'finance-workspace', 'finance-guides', 'finance-guide', 'finance-form-stack', 'finance-row',
    'patient-hero', 'patient-tabs-shell', 'patient-tab-nav', 'patient-panel', 'patient-data-list',
    'procedure-card', 'procedure-form-panel', 'procedure-hero', 'procedure-summary', 'procedure-form',
];
$sortedScenarios = $expectedScenarios;
sort($sortedScenarios);
$sortedTargets = $expectedTargets;
sort($sortedTargets);

if (($baseline['policy'] ?? '') !== 'presentation-computed-style-ux-v2') {
    $failures[] = 'baseline:policy';
}
if (($baseline['playwright'] ?? '') !== '1.59.1') {
    $failures[] = 'baseline:playwright_pin';
}
if (($baseline['fixture'] ?? '') !== 'tests/presentation/ux-fixture.html') {
    $failures[] = 'baseline:fixture';
}
$scenarios = is_array($baseline['scenarios'] ?? null) ? $baseline['scenarios'] : [];
$actualScenarioNames = array_keys($scenarios);
sort($actualScenarioNames);
if ($actualScenarioNames !== $sortedScenarios) {
    $failures[] = 'baseline:scenario_matrix';
}
foreach ($expectedScenarios as $scenario) {
    $targets = is_array($scenarios[$scenario] ?? null) ? $scenarios[$scenario] : [];
    $actualTargets = array_keys($targets);
    sort($actualTargets);
    if ($actualTargets !== $sortedTargets) {
        $failures[] = 'baseline:targets:' . $scenario;
        continue;
    }
    foreach ($expectedTargets as $target) {
        $entry = is_array($targets[$target] ?? null) ? $targets[$target] : [];
        if (!is_array($entry['rect'] ?? null) || !is_array($entry['style'] ?? null) || !is_array($entry['variables'] ?? null)) {
            $failures[] = 'baseline:shape:' . $scenario . ':' . $target;
        }
    }
}

if (is_file($fixturePath)) {
    $fixture = (string) file_get_contents($fixturePath);
    if (!str_contains($fixture, '../../public/assets/presentation.css')) {
        $failures[] = 'fixture:canonical_stylesheet';
    }
    foreach ($expectedTargets as $target) {
        if (!str_contains($fixture, 'id="' . $target . '"')) {
            $failures[] = 'fixture:target:' . $target;
        }
    }
}
if (is_file($runnerPath)) {
    $runner = (string) file_get_contents($runnerPath);
    foreach ([
        'playwright', '--write', '--check', 'getComputedStyle', 'getBoundingClientRect', 'primary-hover',
        'mobile-appointments', 'mobile-financial', 'mobile-patient', 'mobile-procedures',
    ] as $needle) {
        if (!str_contains($runner, $needle)) {
            $failures[] = 'runner:' . $needle;
        }
    }
}
if (is_file($workflowPath)) {
    $workflow = (string) file_get_contents($workflowPath);
    foreach (['playwright@1.59.1', 'presentation-ux-contract.mjs --check', 'chromium'] as $needle) {
        if (!str_contains($workflow, $needle)) {
            $failures[] = 'workflow:' . $needle;
        }
    }
}

fwrite(STDOUT, json_encode([
    'ok' => $failures === [],
    'policy' => 'presentation-observable-ux-contract-v2',
    'scenarios' => count($expectedScenarios),
    'targets_per_scenario' => count($expectedTargets),
    'asserted_surfaces' => count($expectedScenarios) * count($expectedTargets),
    'covered_routes' => ['appointments', 'financial', 'patient', 'procedures'],
    'failures' => $failures,
], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . PHP_EOL);
exit($failures === [] ? 0 : 1);
