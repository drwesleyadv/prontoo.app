#!/usr/bin/env python3
from __future__ import annotations
import hashlib, json, re
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
STYLE_ROOT = ROOT / 'app/Presentation/Styles'
MANIFEST = STYLE_ROOT / 'styles.manifest.json'
ARTIFACT = ROOT / 'public/assets/presentation.css'
VERSION = ROOT / 'version.json'


def fail(message: str) -> None:
    raise SystemExit(f'presentation-css-semanticize: {message}')


def split_top_level(source: str) -> list[str]:
    units: list[str] = []
    start = 0
    depth = 0
    i = 0
    quote: str | None = None
    comment = False
    escape = False
    seen_token = False
    while i < len(source):
        ch = source[i]
        nxt = source[i + 1] if i + 1 < len(source) else ''
        if comment:
            if ch == '*' and nxt == '/':
                comment = False
                i += 2
                continue
            i += 1
            continue
        if quote is not None:
            if escape:
                escape = False
            elif ch == '\\':
                escape = True
            elif ch == quote:
                quote = None
            i += 1
            continue
        if ch == '/' and nxt == '*':
            comment = True
            i += 2
            continue
        if ch in ('"', "'"):
            quote = ch
            seen_token = True
            i += 1
            continue
        if not ch.isspace():
            seen_token = True
        if ch == '{':
            depth += 1
        elif ch == '}':
            depth -= 1
            if depth < 0:
                fail('unbalanced closing brace')
            if depth == 0 and seen_token:
                j = i + 1
                while j < len(source) and source[j].isspace():
                    j += 1
                units.append(source[start:j])
                start = j
                i = j
                seen_token = False
                continue
        elif ch == ';' and depth == 0 and seen_token:
            j = i + 1
            while j < len(source) and source[j].isspace():
                j += 1
            units.append(source[start:j])
            start = j
            i = j
            seen_token = False
            continue
        i += 1
    if comment or quote is not None or depth != 0:
        fail('unterminated CSS structure')
    if start < len(source):
        tail = source[start:]
        if tail:
            if units:
                units[-1] += tail
            else:
                units.append(tail)
    if ''.join(units) != source:
        fail('parser changed source bytes')
    return units


def route_name(text: str) -> str:
    names = re.findall(r'body\[data-route=["\']([^"\']+)["\']\]', text)
    unique = sorted(set(names))
    if len(unique) == 1:
        return re.sub(r'[^a-z0-9]+', '-', unique[0].lower()).strip('-') or 'route'
    return 'routes'


def classify(text: str) -> tuple[str, str]:
    low = text.lower()
    if 'body[data-route=' in text:
        return 'routes', route_name(text)
    if low.lstrip().startswith('@media') or low.lstrip().startswith('@supports') or low.lstrip().startswith('@container'):
        return 'states', 'responsive'
    if re.search(r'(:hover|:focus(?:-visible)?|:active|:disabled|\[disabled\]|\[aria-(?:current|expanded|selected|disabled)|\.is-(?:active|open|selected|disabled|loading|read-only|readonly))', low):
        return 'states', 'interaction'
    custom_defs = len(re.findall(r'--[a-z0-9_-]+\s*:', low))
    if custom_defs >= 3 or (':root' in low and '--' in low):
        if 'clinic-' in low:
            return 'tokens', 'clinic'
        if '--md-' in low:
            return 'tokens', 'material'
        return 'tokens', 'semantic'
    stripped = re.sub(r'/\*.*?\*/', '', low, flags=re.S).strip()
    if re.match(r'^(?:@import|@font-face|html\b|body\b|\*\b|\*\s*[,:{]|h[1-6]\b|p\b|a\b|button\b|input\b|select\b|textarea\b)', stripped) and stripped.count('.') <= 3:
        return 'foundation', 'document'
    if re.search(r'\.(?:sr-only|visually-hidden|hidden|nowrap|truncate|muted|text-(?:left|right|center)|u-[a-z0-9_-]+)\b', low):
        return 'utilities', 'utilities'
    if re.search(r'\.(?:pagehead|page-head|cmdbar|command-bar|card|modal|dialog|drawer|toast|tooltip|chip|badge|avatar|field|search|table|tabs?|pagination|empty-state|notice|banner|menu|sidebar|topbar|toolbar|kpi|stat|metric|list-row)\b', low):
        if 'pagehead' in low or 'page-head' in low:
            return 'components', 'page-head'
        return 'components', 'components'
    if re.search(r'\.(?:grid|stack|cluster|directory|dashboard|editor|form-actions|split|layout|shell|panel|section|list)\b', low):
        return 'patterns', 'layout'
    if re.search(r'\b(?:button|input|select|textarea|summary|label|fieldset)\b', stripped):
        return 'primitives', 'controls'
    return 'components', 'components'


def slug_path(layer: str, concern: str, serial: int) -> str:
    return f'{layer}/{serial:03d}-{concern}.css'


def main() -> None:
    manifest = json.loads(MANIFEST.read_text(encoding='utf-8'))
    old_modules = manifest.get('modules') or []
    if not old_modules:
        fail('no source modules')
    source = ''.join((STYLE_ROOT / item['path']).read_text(encoding='utf-8') for item in old_modules)
    artifact = ARTIFACT.read_text(encoding='utf-8')
    if source != artifact:
        fail('current source and artifact differ before migration')
    reference_sha = hashlib.sha256(source.encode()).hexdigest()
    expected_sha = manifest.get('delivery_equivalence', {}).get('reference_sha256')
    if reference_sha != expected_sha:
        fail('current source no longer matches equivalence baseline')

    units = split_top_level(source)
    groups: list[dict] = []
    serial_by_key: dict[tuple[str, str], int] = {}
    max_group_bytes = 96 * 1024
    for unit in units:
        layer, concern = classify(unit)
        if groups and groups[-1]['layer'] == layer and groups[-1]['concern'] == concern and len((groups[-1]['css'] + unit).encode()) <= max_group_bytes:
            groups[-1]['css'] += unit
        else:
            key = (layer, concern)
            serial_by_key[key] = serial_by_key.get(key, 0) + 1
            groups.append({'layer': layer, 'concern': concern, 'serial': serial_by_key[key], 'css': unit})

    for item in old_modules:
        path = STYLE_ROOT / item['path']
        if path.exists():
            path.unlink()

    new_modules = []
    ownership: dict[str, list[str]] = {'pagehead_control': [], 'clinic_identity_tokens': [], 'route_scopes': []}
    seen_paths: set[str] = set()
    for order, group in enumerate(groups, 1):
        rel = slug_path(group['layer'], group['concern'], group['serial'])
        if rel in seen_paths:
            fail(f'duplicate semantic path {rel}')
        seen_paths.add(rel)
        path = STYLE_ROOT / rel
        path.parent.mkdir(parents=True, exist_ok=True)
        css = group['css']
        path.write_text(css, encoding='utf-8', newline='')
        encoded = css.encode()
        entry = {
            'order': order,
            'path': rel,
            'layer': group['layer'],
            'responsibility': group['concern'].replace('-', ' '),
            'concerns': [group['concern']],
            'sha256': hashlib.sha256(encoded).hexdigest(),
            'bytes': len(encoded),
            'important_count': css.count('!important'),
            'route_scope_count': css.count('body[data-route='),
        }
        new_modules.append(entry)
        if '.pagehead-control' in css:
            ownership['pagehead_control'].append(rel)
        if '--clinic-identity-' in css:
            ownership['clinic_identity_tokens'].append(rel)
        if entry['route_scope_count']:
            ownership['route_scopes'].append(rel)

    rebuilt = ''.join((STYLE_ROOT / item['path']).read_text(encoding='utf-8') for item in new_modules)
    if rebuilt != source:
        fail('semantic modules do not reconstruct exact source')
    if any('cascade-band' in item['path'] for item in new_modules):
        fail('cascade band survived semanticization')

    manifest['schema_version'] = 3
    manifest['policy'] = 'presentation-semantic-source-v3'
    manifest['architecture'] = 'ordered_semantic_modules_with_byte_equivalent_delivery'
    manifest['semantic_decomposition_complete'] = True
    manifest['cascade_band_count'] = 0
    manifest['ownership_index'] = ownership
    manifest['modules'] = new_modules
    MANIFEST.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + '\n', encoding='utf-8')

    version = json.loads(VERSION.read_text(encoding='utf-8'))
    version['version'] = '1.8.12.7'
    version['release'] = '1.8.12.7'
    version['generated_at_unix'] = 1786562100
    version['generated_at'] = '2026-08-12T15:15:00-04:00'
    version['updated_at'] = '2026-08-12T15:15:00-04:00'
    version['build'] = '1.8.12.7-presentation-css-semantic-decomposition'
    version['logic_changes'] = True
    version['visual_changes'] = False
    version['functional_equivalence_policy'] = 'byte_identical_css_delivery_after_semantic_source_decomposition'
    version['previous_version'] = '1.8.12.6'
    version['notes'] = 'Bandas de cascata substituídas por módulos CSS semanticamente classificados, preservando ordem e payload byte a byte.'
    version['deployment_sync_id'] = 'github-prontoo-1.8.12.7-presentation-css-semantic-decomposition'
    version['deployment_sync_requested_at'] = '2026-08-12T15:15:00-04:00'
    VERSION.write_text(json.dumps(version, indent=4, ensure_ascii=False) + '\n', encoding='utf-8')

    print(json.dumps({
        'ok': True,
        'units': len(units),
        'semantic_modules': len(new_modules),
        'cascade_band_count': 0,
        'sha256': reference_sha,
        'bytes': len(source.encode()),
        'layers': {layer: sum(1 for m in new_modules if m['layer'] == layer) for layer in manifest['ownership_order']},
    }, indent=2))

if __name__ == '__main__':
    main()
