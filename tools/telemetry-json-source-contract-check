    ['evento_id' => 'old', 'fim_unix_us' => $nowUs - 20 * $dayUs - 1, 'rota' => 'patient', 'database_query_count' => 99],
    ['evento_id' => 'previous-start', 'fim_unix_us' => $nowUs - 20 * $dayUs, 'rota' => 'patient', 'database_query_count' => 2],
    ['evento_id' => 'previous-end', 'fim_unix_us' => $nowUs - 10 * $dayUs - 1, 'rota' => 'landing', 'database_query_count' => 3],
    ['evento_id' => 'current-start', 'fim_unix_us' => $nowUs - 10 * $dayUs, 'rota' => 'patient', 'database_query_count' => 4],
    ['evento_id' => 'current-end', 'fim_unix_us' => $nowUs - 1, 'rota' => 'landing', 'database_query_count' => 5],
    ['evento_id' => 'current-start', 'fim_unix_us' => $nowUs - 2, 'rota' => 'patient', 'database_query_count' => 90],
    ['evento_id' => 'future-boundary', 'fim_unix_us' => $nowUs, 'rota' => 'landing', 'database_query_count' => 99],
];
