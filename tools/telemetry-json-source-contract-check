$assert(
    ($metricSummary['window_mode'] ?? '') === 'rolling_20d_10x10' &&
    ($metricCurrent['pages'] ?? -1) === 2 &&
    ($metricPrevious['pages'] ?? -1) === 2 &&
    ($metricCurrent['database_operations'] ?? -1) === 9 &&
    ($metricPrevious['database_operations'] ?? -1) === 5 &&
    ($metricCurrent['landing'] ?? -1) === 1 &&
    ($metricPrevious['landing'] ?? -1) === 1 &&
    abs((float) ($metricVariations['pages_pct'] ?? 999) - 0.0) < 0.000001 &&
    abs((float) ($metricVariations['database_operations_pct'] ?? 999) - 80.0) < 0.000001 &&
    abs((float) ($metricVariations['landing_pct'] ?? 999) - 0.0) < 0.000001,
    'comparação 10x10 de Páginas, Registros e Landing divergente',
);
$routeEvent = static fn(string $route, int $offsetUs, int $durationNs): array => [
    'fim_unix_us' => $nowUs - $offsetUs,
    'rota' => $route,
    'duracao_ns' => $durationNs,
    'speed_observed' => true,
    'sucesso' => true,
];
