    [
        $routeEvent('popular', 1, 500000000),
        $routeEvent('popular', 2, 500000000),
        $routeEvent('popular', 3, 500000000),
        $routeEvent('slow', 4, 400000000),
        $routeEvent('slow', 5, 200000000),
        $routeEvent('fast', 6, 200000000),
        $routeEvent('fast', 7, 100000000),
    ],
    240,
    $nowUs,
);
$routeOrder = array_column((array) ($routeSummary['routes'] ?? []), 'route');
$assert(
    $routeOrder === ['popular', 'fast', 'slow'],
    'Rotas devem ordenar por mais requisições e depois por menor tempo médio',
);
