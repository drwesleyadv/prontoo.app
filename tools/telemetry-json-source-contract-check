<?php
declare(strict_types=1);
require_once __DIR__ . '/compatibility-source.php';
$root = dirname(__DIR__);
require_once $root . '/app/Runtime/Autoload/ProntooAutoloader.php';
$assert = static function (bool $ok, string $message): void {
    if (!$ok) {
        throw new RuntimeException('Contrato de fontes JSON de telemetria: ' . $message);
    }
};
$assert(str_ends_with(\Prontoo\Infrastructure\SupportTelemetry\SupportTelemetryInfrastructureOperations01::telemetry_views_file(), '/views.json'), 'views.json não é canônico');
$assert(str_ends_with(\Prontoo\Infrastructure\SupportTelemetry\SupportTelemetryInfrastructureOperations01::telemetry_speed_file(), '/speed.json'), 'speed.json não é canônico');
$assert(str_ends_with(\Prontoo\Infrastructure\SupportTelemetry\SupportTelemetryInfrastructureOperations03::telemetry_database_records_file(), '/database.json'), 'database.json não é canônico');
$assert(class_exists(\Prontoo\Infrastructure\SupportTelemetry\TelemetryJsonStore::class), 'store JSON canônico não foi carregado');
$admin2 = (string) file_get_contents($root . '/app/Runtime/AdminPages/AdminPagesRuntimeOperations02.php');
$admin3 = (string) file_get_contents($root . '/app/Runtime/AdminPages/AdminPagesRuntimeOperations03.php');
$admin9 = (string) file_get_contents($root . '/app/Runtime/AdminPages/AdminPagesRuntimeOperations09.php');
$login = (string) file_get_contents($root . '/app/Runtime/AuthOnboarding/AuthOnboardingRuntimeOperations07.php');
$presentation3 = (string) file_get_contents($root . '/app/Presentation/AdminPages/AdminPagesPresentationOperations03.php');
$css = (string) file_get_contents($root . '/public/assets/design-system.css');
foreach (['"primary_label" => "Visualizações"', '"secondary_label" => "Registros"', '"Velocidade"'] as $token) {
    $assert(str_contains($admin2, $token), 'gráficos perderam ' . $token);
}
foreach (['"Visualizações"', '"Tempo médio das rotas"', '"Registros"', '"Landing Page"'] as $token) {
    $assert(str_contains($admin3, $token), 'cards perderam ' . $token);
}
$assert(str_contains($admin9, 'telemetry_route_performance_summary(240)') && str_contains($admin9, 'telemetry_comparative_summary()'), 'Performance deixou de usar o contrato canônico');
$assert(str_contains($admin2, 'data-refresh-ms="60000"'), 'cards e gráficos devem atualizar a cada minuto');
$assert(
    str_contains($admin3, '$current["landing_requests"]') &&
    str_contains($admin3, '$variations["landing_requests_pct"]'),
    'card Landing Page deixou de consumir total e comparação canônicos',
);
$loadLinePos = strpos($presentation3, 'metric-chart-line-load');
$recordLinePos = strpos($presentation3, 'metric-chart-line-response');
$assert($loadLinePos !== false && $recordLinePos !== false && $recordLinePos > $loadLinePos, 'Registros devem ser pintados depois de Visualizações no gráfico de 30 dias');
$requestWavePos = strpos($login, 'data-wave-series="requests"');
$recordWavePos = strpos($login, 'data-wave-series="records"');
$assert($requestWavePos !== false && $recordWavePos !== false && $recordWavePos > $requestWavePos, 'Registros devem ser pintados depois de Visualizações no rodapé');
foreach ([
    '.metric-dual-time-chart[data-metric-value-type="count"] .metric-chart-fill-load{fill:#347963;opacity:.5}',
    '.metric-dual-time-chart[data-metric-value-type="count"] .metric-chart-fill-response{fill:#1f6f56;opacity:.5}',
    'body.public[data-route="login"] .login-telemetry-wave-path.is-requests{',
    'fill:#347963;',
    'body.public[data-route="login"] .login-telemetry-wave-path.is-records{',
    'fill:#1f6f56;',
    'body.has-telemetry-mountains .app-telemetry-mountains.is-clinic-themed .login-telemetry-wave-path.is-requests{fill:var(--clinic-accent,var(--brand,#347963))}',
    'body.has-telemetry-mountains .app-telemetry-mountains.is-clinic-themed .login-telemetry-wave-path.is-records{fill:var(--clinic-accent-strong,var(--brand-dark,#1f6f56))}',
] as $visualToken) {
    $assert(str_contains($css, $visualToken), 'hierarquia visual de Visualizações/Registros divergente: ' . $visualToken);
}
$assert(str_contains($login, 'telemetry_route_requests_series_20d()') && str_contains($login, 'telemetry_sequence_records_series_20d()'), 'linha pública/rodapé deixou de usar as séries canônicas');
foreach ([$admin2, $admin3, $admin9, $login] as $source) {
    $assert(!str_contains($source, 'page-loads.jsonl') && !str_contains($source, 'database-record-counts.json'), 'Runtime/Presentation lê arquivo legado diretamente');
}
unset($root, $assert, $admin2, $admin3, $admin9, $login, $presentation3, $css, $loadLinePos, $recordLinePos, $requestWavePos, $recordWavePos, $visualToken, $token, $source);
