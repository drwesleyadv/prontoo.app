#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import json
import re
from pathlib import Path

import tinycss2

ROOT = Path(__file__).resolve().parents[1]
STYLE_ROOT = ROOT / 'app/Presentation/Styles'
MANIFEST_PATH = STYLE_ROOT / 'styles.manifest.json'
ARTIFACT_PATH = ROOT / 'public/assets/presentation.css'
VISUAL_PATH = ROOT / 'app/presentation.visual-contract.json'
VERSION_PATH = ROOT / 'version.json'
RULE_LIST_AT = {'media', 'supports', 'container', 'layer', 'scope', 'starting-style'}


def fail(message: str) -> None:
    raise SystemExit(f'presentation-important-shadow-reduce: {message}')


def line_offsets(source: str) -> list[int]:
    offsets = [0]
    for index, char in enumerate(source):
        if char == '\n':
            offsets.append(index + 1)
    return offsets


def source_offset(node, offsets: list[int]) -> int:
    line = max(1, int(getattr(node, 'source_line', 1)))
    column = max(1, int(getattr(node, 'source_column', 1)))
    return offsets[min(line - 1, len(offsets) - 1)] + column - 1


def scan_rule_end(source: str, start: int) -> int:
    depth = 0
    quote = None
    escape = False
    comment = False
    opened = False
    index = start
    while index < len(source):
        char = source[index]
        nxt = source[index + 1] if index + 1 < len(source) else ''
        if comment:
            if char == '*' and nxt == '/':
                comment = False
                index += 2
                continue
            index += 1
            continue
        if quote is not None:
            if escape:
                escape = False
            elif char == '\\':
                escape = True
            elif char == quote:
                quote = None
            index += 1
            continue
        if char == '/' and nxt == '*':
            comment = True
            index += 2
            continue
        if char in ('"', "'"):
            quote = char
            index += 1
            continue
        if char == '{':
            depth += 1
            opened = True
        elif char == '}' and opened:
            depth -= 1
            if depth == 0:
                return index + 1
        index += 1
    fail(f'unterminated qualified rule at offset {start}')


def scan_declaration_end(source: str, start: int, rule_end: int) -> int:
    round_depth = 0
    square_depth = 0
    curly_depth = 0
    quote = None
    escape = False
    comment = False
    index = start
    while index < rule_end:
        char = source[index]
        nxt = source[index + 1] if index + 1 < rule_end else ''
        if comment:
            if char == '*' and nxt == '/':
                comment = False
                index += 2
                continue
            index += 1
            continue
        if quote is not None:
            if escape:
                escape = False
            elif char == '\\':
                escape = True
            elif char == quote:
                quote = None
            index += 1
            continue
        if char == '/' and nxt == '*':
            comment = True
            index += 2
            continue
        if char in ('"', "'"):
            quote = char
            index += 1
            continue
        if char == '(':
            round_depth += 1
        elif char == ')':
            round_depth = max(0, round_depth - 1)
        elif char == '[':
            square_depth += 1
        elif char == ']':
            square_depth = max(0, square_depth - 1)
        elif char == '{':
            curly_depth += 1
        elif char == '}':
            if curly_depth > 0:
                curly_depth -= 1
            elif round_depth == 0 and square_depth == 0:
                return index
        elif char == ';' and round_depth == 0 and square_depth == 0 and curly_depth == 0:
            return index + 1
        index += 1
    fail(f'unterminated declaration at offset {start}')


def normalize_selector(tokens) -> str:
    return ' '.join(tinycss2.serialize(tokens).split())


def normalize_value(tokens) -> str:
    return tinycss2.serialize(tokens).strip()


def parse_raw_declaration(raw: str):
    parsed = tinycss2.parse_declaration_list(raw, skip_whitespace=True, skip_comments=True)
    declarations = [item for item in parsed if item.type == 'declaration']
    if len(declarations) != 1:
        fail(f'raw declaration span parsed as {len(declarations)} declarations: {raw[:120]!r}')
    return declarations[0]


def collect_important(rules, context, rows, source: str, offsets: list[int]) -> None:
    for rule in rules:
        if rule.type == 'qualified-rule':
            selector = normalize_selector(rule.prelude)
            rule_start = source_offset(rule, offsets)
            rule_end = scan_rule_end(source, rule_start)
            declarations = tinycss2.parse_declaration_list(rule.content, skip_whitespace=False, skip_comments=False)
            for item in declarations:
                if item.type != 'declaration' or not item.important:
                    continue
                start = source_offset(item, offsets)
                end = scan_declaration_end(source, start, rule_end)
                raw = source[start:end]
                parsed = parse_raw_declaration(raw)
                if (
                    str(parsed.lower_name) != str(item.lower_name)
                    or not parsed.important
                    or normalize_value(parsed.value) != normalize_value(item.value)
                ):
                    fail(f'declaration source-position drift for {selector} {item.lower_name}')
                rows.append({
                    'context': tuple(context),
                    'selector': selector,
                    'property': str(item.lower_name),
                    'value': normalize_value(item.value),
                    'start': start,
                    'end': end,
                    'raw': raw,
                })
        elif rule.type == 'at-rule' and rule.content is not None and str(rule.lower_at_keyword) in RULE_LIST_AT:
            prelude = ' '.join(tinycss2.serialize(rule.prelude).split())
            inner = tinycss2.parse_rule_list(rule.content, skip_whitespace=False, skip_comments=False)
            collect_important(inner, context + ((str(rule.lower_at_keyword), prelude),), rows, source, offsets)


def duplicate_selector_headers(css: str) -> int:
    selectors: dict[str, int] = {}
    for match in re.finditer(r'([^{}]+)\{([^{}]*)\}', css):
        selector = re.sub(r'\s+', ' ', match.group(1).strip())
        if selector and not selector.startswith('@'):
            selectors[selector] = selectors.get(selector, 0) + 1
    return sum(1 for count in selectors.values() if count > 1)


def metrics(css: str) -> dict[str, int]:
    return {
        'css_lines': css.count('\n') + 1,
        'css_nonblank_lines': sum(1 for line in css.splitlines() if line.strip()),
        'css_bytes': len(css.encode()),
        'important_count': css.count('!important'),
        'route_scope_count': css.count('body[data-route='),
        'duplicate_selector_headers': duplicate_selector_headers(css),
        'duplicate_selector_list_entries': 0,
        'factorable_route_scope_groups': 0,
    }


def main() -> None:
    css = ARTIFACT_PATH.read_text(encoding='utf-8')
    offsets = line_offsets(css)
    rows: list[dict] = []
    stylesheet = tinycss2.parse_stylesheet(css, skip_whitespace=False, skip_comments=False)
    collect_important(stylesheet, tuple(), rows, css, offsets)
    if len(rows) != 5083:
        fail(f'important parse count drift: expected 5083, got {len(rows)}')

    groups: dict[tuple, list[int]] = {}
    for index, row in enumerate(rows):
        key = (row['context'], row['selector'], row['property'], row['value'])
        groups.setdefault(key, []).append(index)
    removal_indexes: list[int] = []
    reasserted_keys = 0
    for indexes in groups.values():
        if len(indexes) < 2:
            continue
        reasserted_keys += 1
        removal_indexes.extend(indexes[:-1])
    if len(removal_indexes) != 141 or reasserted_keys != 133:
        fail(f'formal audit drift: removals={len(removal_indexes)} keys={reasserted_keys}')

    removals = sorted((rows[index] for index in removal_indexes), key=lambda row: row['start'])
    for previous, current in zip(removals, removals[1:]):
        if previous['end'] > current['start']:
            fail('overlapping important declaration spans')
    for row in removals:
        if '!important' not in row['raw'].lower():
            fail('candidate raw declaration does not contain !important')

    direct = css
    for row in reversed(removals):
        if direct[row['start']:row['end']] != row['raw']:
            fail('direct candidate span changed before removal')
        direct = direct[:row['start']] + direct[row['end']:]
    if css.count('!important') - direct.count('!important') != 141:
        fail('direct important reduction is not exactly 141')

    manifest = json.loads(MANIFEST_PATH.read_text(encoding='utf-8'))
    if manifest.get('schema_version') != 5:
        fail('presentation source v5 manifest required')
    sources = manifest.get('sources') or []
    sequence = manifest.get('sequence') or []
    source_data = {item['path']: (STYLE_ROOT / item['path']).read_bytes() for item in sources}
    source_next = {path: 0 for path in source_data}
    owner_buffers = {path: bytearray() for path in source_data}
    new_sequence: list[dict] = []
    artifact_cursor = 0
    removal_hits = {row['start']: 0 for row in removals}

    for item in sequence:
        path = item['source']
        offset = int(item['offset'])
        size = int(item['bytes'])
        if offset != source_next[path]:
            fail('source sequence is not contiguous')
        raw = source_data[path][offset:offset + size]
        if len(raw) != size or hashlib.sha256(raw).hexdigest() != item['sha256']:
            fail('source slice drift before important reduction')
        text = raw.decode('utf-8')
        segment_start = artifact_cursor
        segment_end = segment_start + len(text)
        local = []
        for row in removals:
            if row['start'] >= segment_start and row['end'] <= segment_end:
                local.append(row)
            elif row['start'] < segment_end and row['end'] > segment_end:
                fail('important declaration crosses semantic sequence segment')
        for row in sorted(local, key=lambda candidate: candidate['start'], reverse=True):
            local_start = row['start'] - segment_start
            local_end = row['end'] - segment_start
            if text[local_start:local_end] != row['raw']:
                fail('local important declaration span mismatch')
            text = text[:local_start] + text[local_end:]
            removal_hits[row['start']] += 1
        encoded = text.encode('utf-8')
        if encoded:
            new_offset = len(owner_buffers[path])
            owner_buffers[path].extend(encoded)
            new_sequence.append({
                'order': len(new_sequence) + 1,
                'source': path,
                'offset': new_offset,
                'bytes': len(encoded),
                'sha256': hashlib.sha256(encoded).hexdigest(),
                'important_count': text.count('!important'),
                'route_scope_count': text.count('body[data-route='),
            })
        source_next[path] += size
        artifact_cursor = segment_end

    if artifact_cursor != len(css):
        fail('sequence no longer covers artifact')
    if any(count != 1 for count in removal_hits.values()):
        fail('not every formal candidate was removed exactly once')
    for path, raw in source_data.items():
        if source_next[path] != len(raw):
            fail(f'source bytes uncovered: {path}')

    new_css = ''.join(
        bytes(owner_buffers[item['source']])[item['offset']:item['offset'] + item['bytes']].decode('utf-8')
        for item in new_sequence
    )
    if new_css != direct:
        fail('semantic owner reconstruction differs from direct declaration removal')

    source_meta = {item['path']: item for item in sources}
    new_sources = []
    for item in sources:
        path = item['path']
        raw = bytes(owner_buffers[path])
        text = raw.decode('utf-8')
        (STYLE_ROOT / path).write_bytes(raw)
        old = source_meta[path]
        new_sources.append({
            'path': path,
            'layer': old['layer'],
            'responsibility': old['responsibility'],
            'concern': old['concern'],
            'sha256': hashlib.sha256(raw).hexdigest(),
            'bytes': len(raw),
            'important_count': text.count('!important'),
            'route_scope_count': text.count('body[data-route='),
        })

    ARTIFACT_PATH.write_text(new_css, encoding='utf-8', newline='')
    before = metrics(css)
    after = metrics(new_css)
    if before['important_count'] != 5083 or after['important_count'] != 4942:
        fail(f'important target drift: {before["important_count"]}->{after["important_count"]}')
    for key in ['route_scope_count', 'duplicate_selector_headers', 'duplicate_selector_list_entries', 'factorable_route_scope_groups']:
        if after[key] != before[key]:
            fail(f'unrelated visual debt metric changed: {key} {before[key]}->{after[key]}')

    current_sha = hashlib.sha256(new_css.encode()).hexdigest()
    manifest['artifact_contract'] = {
        'sha256': current_sha,
        'bytes': after['css_bytes'],
        'lines': after['css_lines'],
        'deterministic_source_required': True,
    }
    manifest['visual_debt_budget']['important_count_max'] = 4942
    manifest['visual_debt_budget']['route_scope_count_max'] = after['route_scope_count']
    manifest['visual_debt_budget']['duplicate_selector_headers_max'] = after['duplicate_selector_headers']
    manifest['important_shadow_reduction'] = {
        'policy': 'earlier_identical_important_same_context_selector_property_value_is_inert_when_later_reassertion_exists',
        'removed_declarations': 141,
        'distinct_reasserted_keys': 133,
        'remaining_important_count': 4942,
    }
    manifest['sources'] = new_sources
    manifest['sequence'] = new_sequence
    manifest['sequence_segment_count'] = len(new_sequence)
    MANIFEST_PATH.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + '\n', encoding='utf-8')

    visual = json.loads(VISUAL_PATH.read_text(encoding='utf-8'))
    previous = dict(visual['metrics']['after'])
    previous['shadowed_identical_important_declarations'] = 141
    final = dict(previous)
    final.update(after)
    final['shadowed_identical_important_declarations'] = 0
    visual['version'] = '1.8.12.12'
    visual['reference']['previous_release'] = '1.8.12.11'
    visual['reference']['previous_visual_reference'] = 'exact_duplicate_rule_elimination_v1'
    visual['reference']['visual_reference'] = 'important_shadow_reduction_v1'
    visual['reference']['functional_equivalence'] = 'later_identical_important_declaration_retained_same_context_selector_property_value_plus_computed_style_geometry_baseline_stable'
    visual['metrics']['before'] = previous
    visual['metrics']['after'] = final
    visual['metrics']['delta'] = {
        key: final[key] - previous[key]
        for key in final
        if isinstance(final.get(key), int) and isinstance(previous.get(key), int)
    }
    visual['debt_budget']['important_count'] = 4942
    visual['debt_budget']['route_scope_count'] = after['route_scope_count']
    visual['debt_budget']['duplicate_selector_headers'] = after['duplicate_selector_headers']
    visual['debt_budget']['shadowed_identical_important_declarations'] = 0
    visual['delivery']['current_sha256'] = current_sha
    visual['delivery']['current_bytes'] = after['css_bytes']
    VISUAL_PATH.write_text(json.dumps(visual, indent=4, ensure_ascii=False) + '\n', encoding='utf-8')

    version = json.loads(VERSION_PATH.read_text(encoding='utf-8'))
    version['version'] = '1.8.12.12'
    version['release'] = '1.8.12.12'
    version['build'] = '1.8.12.12-presentation-important-shadow-reduction'
    version['previous_version'] = '1.8.12.11'
    version['database_changes'] = False
    version['schema_changes'] = False
    version['logic_changes'] = True
    version['visual_changes'] = False
    version['functional_equivalence_policy'] = 'remove_only_formally_shadowed_identical_important_declarations_and_hold_pinned_ux_baseline'
    version['notes'] = '141 declarações !important anteriores e formalmente inertes são removidas; a reasserção posterior idêntica no mesmo seletor/contexto é preservada.'
    VERSION_PATH.write_text(json.dumps(version, indent=4, ensure_ascii=False) + '\n', encoding='utf-8')

    print(json.dumps({
        'ok': True,
        'formal_candidates_removed': 141,
        'distinct_reasserted_keys': 133,
        'before': before,
        'after': after,
        'byte_delta': after['css_bytes'] - before['css_bytes'],
        'line_delta': after['css_lines'] - before['css_lines'],
        'sha256': current_sha,
        'sequence_segments': len(new_sequence),
    }, indent=2, ensure_ascii=False))


if __name__ == '__main__':
    main()
