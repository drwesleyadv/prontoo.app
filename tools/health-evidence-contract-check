<?php
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit(1);
}

$root = dirname(__DIR__);
$required = [
    'app/Domain/Health/HealthEvidencePolicy.php',
    'app/Domain/Health/HealthEvidenceBuilder.php',
    'app/Infrastructure/Health/HealthEvidenceStore.php',
    'app/Infrastructure/Health/HealthCanary.php',
    'app/Runtime/AdminPages/AdminPagesRuntimeOperations01.php',
    'app/Runtime/AdminPages/AdminPagesRuntimeOperations06.php',
    'cron/maestro.php',
];
foreach ($required as $file) {
    if (!is_file($root . '/' . $file)) {
        fwrite(STDERR, '[health-evidence] arquivo ausente: ' . $file . PHP_EOL);
        exit(1);
    }
}
$policy = (string) file_get_contents($root . '/app/Domain/Health/HealthEvidencePolicy.php');
$builder = (string) file_get_contents($root . '/app/Domain/Health/HealthEvidenceBuilder.php');
$store = (string) file_get_contents($root . '/app/Infrastructure/Health/HealthEvidenceStore.php');
$canary = (string) file_get_contents($root . '/app/Infrastructure/Health/HealthCanary.php');
$admin = (string) file_get_contents($root . '/app/Runtime/AdminPages/AdminPagesRuntimeOperations01.php');
$overview = (string) file_get_contents($root . '/app/Runtime/AdminPages/AdminPagesRuntimeOperations06.php');
$cron = (string) file_get_contents($root . '/cron/maestro.php');
$checks = [
    str_contains($policy, "STATE_UNKNOWN = 'unknown'"),
    str_contains($policy, "'valid_until'"),
    str_contains($policy, 'stabilizeTransient'),
    str_contains($policy, 'structuralActions'),
    str_contains($builder, "'performance.runtime'"),
    str_contains($builder, "'continuity.canary'"),
    str_contains($store, "'prontoo.health-transition.v1'"),
    str_contains($store, 'appendTransitions'),
    str_contains($canary, "'mutation_invariant'"),
    str_contains($canary, "'scope_context'"),
    str_contains($admin, 'HealthEvidenceBuilder::build'),
    str_contains($overview, 'HealthEvidencePolicy::structuralActions'),
    str_contains($cron, 'HealthCanary::run'),
];
if (in_array(false, $checks, true)) {
    fwrite(STDERR, '[health-evidence] contrato incompleto' . PHP_EOL);
    exit(1);
}
if (is_file($root . '/app/Runtime/Health/HealthEvidenceRegistry.php')) {
    fwrite(STDERR, '[health-evidence] coleta não pode voltar a um hotspot Runtime dedicado' . PHP_EOL);
    exit(1);
}
if (preg_match('/version_contract[^\n]{0,220}\[\s*["\x27]ok["\x27]\s*=>\s*true/s', $admin)) {
    fwrite(STDERR, '[health-evidence] contrato de versão não pode falhar aberto' . PHP_EOL);
    exit(1);
}
fwrite(STDOUT, json_encode([
    'ok' => true,
    'policy' => 'health-evidence-registry-v2',
    'states' => ['ok', 'attention', 'fail', 'unknown'],
    'dimensions' => ['availability', 'integrity', 'security', 'performance', 'continuity'],
    'transition_only_history' => true,
    'runtime_hotspot' => false,
], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT) . PHP_EOL);
