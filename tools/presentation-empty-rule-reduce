#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import json
import re
from pathlib import Path

import tinycss2

ROOT = Path(__file__).resolve().parents[1]
STYLE_ROOT = ROOT / 'app/Presentation/Styles'
MANIFEST_PATH = STYLE_ROOT / 'styles.manifest.json'
ARTIFACT_PATH = ROOT / 'public/assets/presentation.css'
VISUAL_PATH = ROOT / 'app/presentation.visual-contract.json'
VERSION_PATH = ROOT / 'version.json'
RULE_LIST_AT = {'media', 'supports', 'container', 'layer', 'scope', 'starting-style'}


def fail(message: str) -> None:
    raise SystemExit(f'presentation-empty-rule-reduce: {message}')


def line_offsets(source: str) -> list[int]:
    offsets = [0]
    for index, char in enumerate(source):
        if char == '\n':
            offsets.append(index + 1)
    return offsets


def source_offset(node, offsets: list[int]) -> int:
    line = max(1, int(getattr(node, 'source_line', 1)))
    column = max(1, int(getattr(node, 'source_column', 1)))
    return offsets[min(line - 1, len(offsets) - 1)] + column - 1


def scan_rule_end(source: str, start: int) -> int:
    depth = 0
    quote = None
    escape = False
    comment = False
    opened = False
    index = start
    while index < len(source):
        char = source[index]
        nxt = source[index + 1] if index + 1 < len(source) else ''
        if comment:
            if char == '*' and nxt == '/':
                comment = False
                index += 2
                continue
            index += 1
            continue
        if quote is not None:
            if escape:
                escape = False
            elif char == '\\':
                escape = True
            elif char == quote:
                quote = None
            index += 1
            continue
        if char == '/' and nxt == '*':
            comment = True
            index += 2
            continue
        if char in ('"', "'"):
            quote = char
            index += 1
            continue
        if char == '{':
            depth += 1
            opened = True
        elif char == '}' and opened:
            depth -= 1
            if depth == 0:
                return index + 1
        index += 1
    fail(f'unterminated CSS rule at offset {start}')


def only_whitespace_comments(tokens) -> bool:
    return all(item.type in {'whitespace', 'comment'} for item in tokens)


def node_dead(node) -> bool:
    if node.type == 'qualified-rule':
        content = tinycss2.parse_component_value_list(tinycss2.serialize(node.content))
        return only_whitespace_comments(content)
    if node.type == 'at-rule' and node.content is not None and str(node.lower_at_keyword) in RULE_LIST_AT:
        inner = tinycss2.parse_rule_list(node.content, skip_whitespace=False, skip_comments=False)
        significant = [item for item in inner if item.type not in {'whitespace', 'comment'}]
        if not significant:
            return True
        if any(item.type == 'error' for item in significant):
            return False
        return all(node_dead(item) for item in significant)
    return False


def collect_top_dead(nodes, source: str, offsets: list[int], context: tuple, removals: list[dict], stats: dict) -> None:
    for node in nodes:
        if node.type in {'whitespace', 'comment'}:
            continue
        if node_dead(node):
            start = source_offset(node, offsets)
            end = scan_rule_end(source, start)
            raw = source[start:end]
            kind = 'qualified' if node.type == 'qualified-rule' else 'at-rule'
            label = ' '.join(tinycss2.serialize(node.prelude).split()) if hasattr(node, 'prelude') else ''
            removals.append({'start': start, 'end': end, 'raw': raw, 'kind': kind, 'label': label, 'context': context})
            stats['top_dead_rules'] += 1
            stats['qualified_dead'] += int(node.type == 'qualified-rule')
            stats['container_dead'] += int(node.type == 'at-rule')
            stats['route_scopes_removed'] += raw.count('body[data-route=')
            stats['important_removed'] += raw.count('!important')
            continue
        if node.type == 'at-rule' and node.content is not None and str(node.lower_at_keyword) in RULE_LIST_AT:
            prelude = ' '.join(tinycss2.serialize(node.prelude).split())
            inner = tinycss2.parse_rule_list(node.content, skip_whitespace=False, skip_comments=False)
            collect_top_dead(inner, source, offsets, context + ((str(node.lower_at_keyword), prelude),), removals, stats)


def duplicate_selector_headers(css: str) -> int:
    selectors = {}
    for match in re.finditer(r'([^{}]+)\{([^{}]*)\}', css):
        selector = re.sub(r'\s+', ' ', match.group(1).strip())
        if selector and not selector.startswith('@'):
            selectors[selector] = selectors.get(selector, 0) + 1
    return sum(1 for count in selectors.values() if count > 1)


def metrics(css: str) -> dict[str, int]:
    return {
        'css_lines': css.count('\n') + 1,
        'css_nonblank_lines': sum(1 for line in css.splitlines() if line.strip()),
        'css_bytes': len(css.encode()),
        'important_count': css.count('!important'),
        'route_scope_count': css.count('body[data-route='),
        'duplicate_selector_headers': duplicate_selector_headers(css),
        'duplicate_selector_list_entries': 0,
        'factorable_route_scope_groups': 0,
    }


def main() -> None:
    css = ARTIFACT_PATH.read_text(encoding='utf-8')
    offsets = line_offsets(css)
    stylesheet = tinycss2.parse_stylesheet(css, skip_whitespace=False, skip_comments=False)
    removals = []
    stats = {'top_dead_rules': 0, 'qualified_dead': 0, 'container_dead': 0, 'route_scopes_removed': 0, 'important_removed': 0}
    collect_top_dead(stylesheet, css, offsets, tuple(), removals, stats)
    if stats['top_dead_rules'] < 1:
        fail('no raw-empty CSS nodes found')
    if stats['important_removed'] != 0:
        fail('dead-node reduction unexpectedly contains important declarations')
    removals.sort(key=lambda row: row['start'])
    for previous, current in zip(removals, removals[1:]):
        if previous['end'] > current['start']:
            fail('top-dead spans overlap')
    direct = css
    for row in reversed(removals):
        if direct[row['start']:row['end']] != row['raw']:
            fail('dead span changed before removal')
        direct = direct[:row['start']] + direct[row['end']:]

    reparsed = tinycss2.parse_stylesheet(direct, skip_whitespace=False, skip_comments=False)
    remaining = []
    remaining_stats = {'top_dead_rules': 0, 'qualified_dead': 0, 'container_dead': 0, 'route_scopes_removed': 0, 'important_removed': 0}
    collect_top_dead(reparsed, direct, line_offsets(direct), tuple(), remaining, remaining_stats)
    if remaining_stats['top_dead_rules'] != 0:
        fail(f'dead CSS nodes remain after one recursive reduction: {remaining_stats}')

    manifest = json.loads(MANIFEST_PATH.read_text(encoding='utf-8'))
    sources = manifest['sources']
    sequence = manifest['sequence']
    source_data = {item['path']: (STYLE_ROOT / item['path']).read_bytes() for item in sources}
    source_next = {path: 0 for path in source_data}
    owner_buffers = {path: bytearray() for path in source_data}
    new_sequence = []
    cursor = 0
    hits = {row['start']: 0 for row in removals}
    for item in sequence:
        path = item['source']
        offset = int(item['offset'])
        size = int(item['bytes'])
        if offset != source_next[path]:
            fail('source sequence not contiguous')
        raw = source_data[path][offset:offset + size]
        if len(raw) != size or hashlib.sha256(raw).hexdigest() != item['sha256']:
            fail('source slice drift before dead-node reduction')
        text = raw.decode('utf-8')
        seg_start = cursor
        seg_end = seg_start + len(text)
        local = []
        for row in removals:
            if row['start'] >= seg_start and row['end'] <= seg_end:
                local.append(row)
            elif row['start'] < seg_end and row['end'] > seg_end:
                fail('dead rule crosses semantic sequence segment')
        for row in sorted(local, key=lambda candidate: candidate['start'], reverse=True):
            a = row['start'] - seg_start
            b = row['end'] - seg_start
            if text[a:b] != row['raw']:
                fail('local dead-node span mismatch')
            text = text[:a] + text[b:]
            hits[row['start']] += 1
        encoded = text.encode('utf-8')
        if encoded:
            new_offset = len(owner_buffers[path])
            owner_buffers[path].extend(encoded)
            new_sequence.append({
                'order': len(new_sequence) + 1,
                'source': path,
                'offset': new_offset,
                'bytes': len(encoded),
                'sha256': hashlib.sha256(encoded).hexdigest(),
                'important_count': text.count('!important'),
                'route_scope_count': text.count('body[data-route='),
            })
        source_next[path] += size
        cursor = seg_end
    if cursor != len(css) or any(value != 1 for value in hits.values()):
        fail('sequence/dead-node coverage drift')
    for path, raw in source_data.items():
        if source_next[path] != len(raw):
            fail(f'uncovered source bytes {path}')

    new_css = ''.join(bytes(owner_buffers[item['source']])[item['offset']:item['offset'] + item['bytes']].decode('utf-8') for item in new_sequence)
    if new_css != direct:
        fail('owner reconstruction differs from direct dead-node reduction')
    source_meta = {item['path']: item for item in sources}
    new_sources = []
    retained_sources = []
    for item in sources:
        path = item['path']
        raw = bytes(owner_buffers[path])
        if not raw:
            css_path = STYLE_ROOT / path
            if css_path.exists():
                css_path.unlink()
            continue
        text = raw.decode('utf-8')
        (STYLE_ROOT / path).write_bytes(raw)
        old = source_meta[path]
        retained_sources.append(path)
        new_sources.append({
            'path': path,
            'layer': old['layer'],
            'responsibility': old['responsibility'],
            'concern': old['concern'],
            'sha256': hashlib.sha256(raw).hexdigest(),
            'bytes': len(raw),
            'important_count': text.count('!important'),
            'route_scope_count': text.count('body[data-route='),
        })
    ARTIFACT_PATH.write_text(new_css, encoding='utf-8', newline='')
    before = metrics(css)
    after = metrics(new_css)
    if after['important_count'] != before['important_count']:
        fail('important debt changed during empty-rule reduction')
    if before['route_scope_count'] - after['route_scope_count'] != stats['route_scopes_removed']:
        fail('route-scope delta differs from removed dead spans')

    current_sha = hashlib.sha256(new_css.encode()).hexdigest()
    manifest['artifact_contract'] = {'sha256': current_sha, 'bytes': after['css_bytes'], 'lines': after['css_lines'], 'deterministic_source_required': True}
    manifest['visual_debt_budget']['important_count_max'] = after['important_count']
    manifest['visual_debt_budget']['route_scope_count_max'] = after['route_scope_count']
    manifest['visual_debt_budget']['duplicate_selector_headers_max'] = after['duplicate_selector_headers']
    manifest['empty_rule_reduction'] = {
        'policy': 'only_raw_whitespace_or_comment_bodies_and_recursively_dead_rule_containers_are_removed',
        'removed_top_level_dead_nodes': stats['top_dead_rules'],
        'removed_qualified_rules': stats['qualified_dead'],
        'removed_rule_containers': stats['container_dead'],
        'removed_route_scope_occurrences': stats['route_scopes_removed'],
        'remaining_dead_nodes': 0,
    }
    manifest['sources'] = new_sources
    manifest['sequence'] = new_sequence
    manifest['sequence_segment_count'] = len(new_sequence)
    manifest['physical_source_file_count'] = len(new_sources)
    manifest['physical_source_file_count_max'] = min(int(manifest.get('physical_source_file_count_max', len(new_sources))), len(new_sources))
    MANIFEST_PATH.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + '\n', encoding='utf-8')

    visual = json.loads(VISUAL_PATH.read_text(encoding='utf-8'))
    previous = dict(visual['metrics']['after'])
    final = dict(previous)
    final.update(after)
    visual['version'] = '1.8.12.14'
    visual['reference']['previous_release'] = '1.8.12.13'
    visual['reference']['previous_visual_reference'] = 'normal_shadow_reduction_v1'
    visual['reference']['visual_reference'] = 'raw_empty_rule_reduction_v1'
    visual['reference']['functional_equivalence'] = 'only_rules_with_no_raw_effect_are_removed_plus_computed_style_geometry_baseline_stable'
    visual['metrics']['before'] = previous
    visual['metrics']['after'] = final
    visual['metrics']['delta'] = {key: final[key] - previous[key] for key in final if isinstance(final.get(key), int) and isinstance(previous.get(key), int)}
    visual['debt_budget']['important_count'] = after['important_count']
    visual['debt_budget']['route_scope_count'] = after['route_scope_count']
    visual['debt_budget']['duplicate_selector_headers'] = after['duplicate_selector_headers']
    visual.setdefault('proofs', {})['empty_rule_reduction'] = stats | {'remaining_dead_nodes': 0}
    visual['delivery']['current_sha256'] = current_sha
    visual['delivery']['current_bytes'] = after['css_bytes']
    VISUAL_PATH.write_text(json.dumps(visual, indent=4, ensure_ascii=False) + '\n', encoding='utf-8')

    version = json.loads(VERSION_PATH.read_text(encoding='utf-8'))
    version['version'] = '1.8.12.14'
    version['release'] = '1.8.12.14'
    version['build'] = '1.8.12.14-presentation-empty-rule-reduction'
    version['previous_version'] = '1.8.12.13'
    version['database_changes'] = False
    version['schema_changes'] = False
    version['logic_changes'] = True
    version['visual_changes'] = False
    version['functional_equivalence_policy'] = 'remove_only_raw_empty_or_recursively_dead_css_rules_and_hold_pinned_ux_baseline'
    version['notes'] = 'Regras sem qualquer conteúdo visual e containers compostos apenas por regras mortas são removidos recursivamente; declarações inválidas/toleradas permanecem intocadas.'
    VERSION_PATH.write_text(json.dumps(version, indent=4, ensure_ascii=False) + '\n', encoding='utf-8')

    print(json.dumps({
        'ok': True,
        'removed': stats,
        'before': before,
        'after': after,
        'byte_delta': after['css_bytes'] - before['css_bytes'],
        'line_delta': after['css_lines'] - before['css_lines'],
        'physical_source_files': len(new_sources),
        'sequence_segments': len(new_sequence),
        'sha256': current_sha,
    }, indent=2, ensure_ascii=False))


if __name__ == '__main__':
    main()
