<?php
declare(strict_types=1);
require_once __DIR__ . '/compatibility-source.php';

$root = dirname(__DIR__);
require_once $root . '/app/Runtime/Autoload/ProntooAutoloader.php';
$assert = static function (bool $condition, string $message): void {
    if (!$condition) {
        throw new RuntimeException("Contrato de telemetria de registros: " . $message);
    }
};
$timezone = new DateTimeZone("America/Cuiaba");
$now = (new DateTimeImmutable("2026-08-11 15:37:00", $timezone))->getTimestamp();
$windowStart = $now - 30 * 86400;
$samples = [];
for ($index = 0; $index < 30; $index++) {
    $samples[] = [
        "captured_at_unix" => $windowStart + $index * 86400 + 300,
        "total_records" => 1000 + $index,
        "delta_records" => $index === 29 ? -7 : $index + 1,
    ];
}
$samples[] = [
    "captured_at_unix" => $now,
    "total_records" => 2000,
    "delta_records" => 999,
];
$series = \Prontoo\Infrastructure\SupportTelemetry\SupportTelemetryInfrastructureOperations03::telemetry_database_record_series_from_samples(
    $samples,
    $now,
);
$assert(
    str_ends_with(\Prontoo\Infrastructure\SupportTelemetry\SupportTelemetryInfrastructureOperations03::telemetry_database_records_file(), "/database.json"),
    "database.json deve ser a fonte canônica de Registros",
);
$assert(count($series) === 30, "a série deve conter exatamente 30 janelas móveis de 24h");
$assert((int) ($series[0]["ts"] ?? 0) === $windowStart, "primeira fronteira móvel incorreta");
$assert((int) ($series[29]["ts"] ?? 0) === $now - 86400, "última fronteira móvel incorreta");
$assert((int) ($series[29]["value"] ?? 0) === -7, "deltas negativos devem ser preservados");
$assert(
    array_sum(array_map(static fn(array $row): int => (int) ($row["value"] ?? 0), $series)) !== 999,
    "amostra exatamente no timestamp final não pode ultrapassar a janela",
);
$comparison = \Prontoo\Infrastructure\SupportTelemetry\SupportTelemetryInfrastructureOperations03::telemetry_series_comparison_15d(
    $series,
);
$assert((int) ($comparison["previous_total"] ?? 0) === 120, "primeiros 15 dias móveis incorretos");
$assert((int) ($comparison["current_total"] ?? 0) === 308, "últimos 15 dias móveis incorretos");
$assert(
    (int) ($comparison["previous_observed_days"] ?? 0) === 15 &&
        (int) ($comparison["current_observed_days"] ?? 0) === 15,
    "comparação completa deve exigir 15 janelas observadas em cada período",
);
$emptyComparison = \Prontoo\Infrastructure\SupportTelemetry\SupportTelemetryInfrastructureOperations03::telemetry_series_comparison_15d(
    \Prontoo\Infrastructure\SupportTelemetry\SupportTelemetryInfrastructureOperations03::telemetry_database_record_series_from_samples([], $now),
);
$assert(
    array_key_exists("variation_pct", $emptyComparison) &&
        $emptyComparison["variation_pct"] === null,
    "períodos sem cobertura completa não podem produzir percentual",
);
$cron = (string) file_get_contents($root . "/cron/maestro.php");
$assert(
    str_contains($cron, "telemetry_database_record_snapshot_capture()"),
    "Maestro deve capturar o estoque em cada ciclo",
);
$source = (string) file_get_contents(
    $root . "/app/Infrastructure/SupportTelemetry/SupportTelemetryInfrastructureOperations03.php",
);
$assert(
    str_contains($source, '$cutoff = $nowUnix - 31 * 86400;'),
    "database.json deve higienizar amostras a partir de 31 dias",
);
$admin = (string) file_get_contents(
    $root . "/app/Runtime/AdminPages/AdminPagesRuntimeOperations03.php",
);
foreach (["\"Visualizações\"", "\"Tempo médio das rotas\"", "\"Registros\""] as $token) {
    $assert(str_contains($admin, $token), "card obrigatório ausente: " . $token);
}
unset(
    $root,
    $assert,
    $timezone,
    $now,
    $windowStart,
    $samples,
    $series,
    $comparison,
    $emptyComparison,
    $cron,
    $source,
    $admin,
    $token,
);
