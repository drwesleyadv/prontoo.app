<?php
declare(strict_types=1);
require_once __DIR__ . '/canonical-source.php';

$root = dirname(__DIR__);
require_once $root . '/app/Runtime/Autoload/ProntooAutoloader.php';
$assert = static function (bool $condition, string $message): void {
    if (!$condition) {
        throw new RuntimeException("Contrato de telemetria de registros: " . $message);
    }
};
$timezone = new DateTimeZone("America/Cuiaba");
$now = (new DateTimeImmutable("2026-08-17 15:37:00", $timezone))->getTimestamp();
$windowStart = $now - 20 * 86400;
$samples = [];
for ($index = 0; $index < 20; $index++) {
    $samples[] = [
        "captured_at_unix" => $windowStart + $index * 86400 + 300,
        "total_records" => 1000 + $index,
        "delta_records" => $index === 19 ? -7 : $index + 1,
    ];
}
$samples[] = [
    "captured_at_unix" => $now,
    "total_records" => 2000,
    "delta_records" => 999,
];
$series = \Prontoo\Infrastructure\SupportTelemetry\SupportTelemetryInfrastructureOperations03::telemetry_database_record_series_from_samples(
    $samples,
    $now,
);
$assert(
    str_ends_with(\Prontoo\Infrastructure\SupportTelemetry\SupportTelemetryInfrastructureOperations03::telemetry_database_records_file(), "/database.json"),
    "database.json deve ser a fonte canônica de Registros",
);
$assert(count($series) === 20, "a série deve conter exatamente 20 janelas móveis de 24h");
$assert((int) ($series[0]["ts"] ?? 0) === $windowStart, "primeira fronteira móvel incorreta");
$assert((int) ($series[19]["ts"] ?? 0) === $now - 86400, "última fronteira móvel incorreta");
$assert((int) ($series[19]["value"] ?? 0) === -7, "deltas negativos devem ser preservados");
$assert(
    array_sum(array_map(static fn(array $row): int => (int) ($row["value"] ?? 0), $series)) !== 999,
    "amostra exatamente no timestamp final não pode ultrapassar a janela",
);
$comparison = \Prontoo\Infrastructure\SupportTelemetry\SupportTelemetryInfrastructureOperations03::telemetry_database_record_comparison_10d_from_series(
    $series,
);
$assert((int) ($comparison["previous_total"] ?? 0) === 55, "primeiros 10 dias móveis incorretos");
$assert((int) ($comparison["current_total"] ?? 0) === 128, "últimos 10 dias móveis incorretos");
$assert(
    (int) ($comparison["previous_observed_days"] ?? 0) === 10 &&
        (int) ($comparison["current_observed_days"] ?? 0) === 10,
    "comparação completa deve exigir 10 janelas observadas em cada período",
);
$assert(
    abs((float) ($comparison["variation_pct"] ?? 0.0) - 132.727273) < 0.000001,
    "variação percentual 10x10 incorreta",
);
$emptyComparison = \Prontoo\Infrastructure\SupportTelemetry\SupportTelemetryInfrastructureOperations03::telemetry_database_record_comparison_10d_from_series(
    \Prontoo\Infrastructure\SupportTelemetry\SupportTelemetryInfrastructureOperations03::telemetry_database_record_series_from_samples([], $now),
);
$assert(
    (int) ($emptyComparison["current_total"] ?? -1) === 0 &&
        array_key_exists("variation_pct", $emptyComparison) &&
        $emptyComparison["variation_pct"] === null,
    "bootstrap sem histórico deve manter Registros em zero e percentual indefinido",
);
$cron = (string) file_get_contents($root . "/cron/maestro.php");
$assert(
    str_contains($cron, "telemetry_database_record_snapshot_capture()"),
    "Maestro deve capturar o estoque em cada ciclo",
);
$source = (string) file_get_contents(
    $root . "/app/Infrastructure/SupportTelemetry/SupportTelemetryInfrastructureOperations03.php",
);
foreach ([
    'private const RETENTION_DAYS = 20;',
    'private const COMPARISON_DAYS = 10;',
    '"initial_balance_records" => $initialBalance',
    '"last_total_records" => (int) $count["total_records"]',
    '"capture_interval_minutes" => 10',
    '"records_10d" => (int) $comparison["current_total"]',
] as $token) {
    $assert(str_contains($source, $token), "contrato ausente: " . $token);
}
unset(
    $root,
    $assert,
    $timezone,
    $now,
    $windowStart,
    $samples,
    $series,
    $comparison,
    $emptyComparison,
    $cron,
    $source,
);
