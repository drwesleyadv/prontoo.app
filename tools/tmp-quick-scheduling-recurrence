def replace_once(path: str, old: str, new: str) -> None:
    p = Path(path)
    text = p.read_text()
    if old not in text:
        raise SystemExit(f"Trecho não encontrado em {path}: {old[:120]!r}")
    p.write_text(text.replace(old, new, 1))

