<?php
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

$root = dirname(__DIR__);
foreach ([
    'app/Domain/Identity/IdentityDocumentValidator.php',
    'app/Domain/Financial/FinancialMovementMutationPolicy.php',
    'app/Core/Invariant/Workflow/StateMachine.php',
    'app/Runtime/Routing/RouteDefinition.php',
    'app/Runtime/Routing/RouteRegistry.php',
    'app/Application/Financial/FinancialCashierAttentionPort.php',
    'app/Application/Financial/FinancialCashierAttentionService.php',
    'app/Application/Patients/PatientReadPort.php',
    'app/Application/Patients/PatientReadService.php',
] as $file) {
    require_once $root . '/' . $file;
}

use Prontoo\Application\Financial\FinancialCashierAttentionPort;
use Prontoo\Application\Financial\FinancialCashierAttentionService;
use Prontoo\Application\Patients\PatientReadPort;
use Prontoo\Application\Patients\PatientReadService;
use Prontoo\Core\Invariant\Workflow\StateMachine;
use Prontoo\Domain\Financial\FinancialMovementMutationPolicy;
use Prontoo\Domain\Identity\IdentityDocumentValidator;
use Prontoo\Runtime\Routing\RouteRegistry;

$passed = 0;
$failures = [];
$assert = static function (bool $condition, string $name) use (&$passed, &$failures): void {
    if ($condition) {
        $passed++;
        return;
    }
    $failures[] = $name;
};
$same = static function (mixed $expected, mixed $actual, string $name) use ($assert): void {
    $assert($expected === $actual, $name);
};

$assert(IdentityDocumentValidator::cpf('52998224725'), 'identity.cpf.valid');
$assert(!IdentityDocumentValidator::cpf('52998224724'), 'identity.cpf.invalid_check_digit');
$assert(!IdentityDocumentValidator::cpf('11111111111'), 'identity.cpf.repeated_digits');
$assert(IdentityDocumentValidator::cnpj('11222333000181'), 'identity.cnpj.valid');
$assert(!IdentityDocumentValidator::cnpj('11222333000180'), 'identity.cnpj.invalid_check_digit');
$assert(!IdentityDocumentValidator::birthDate('2999-01-01'), 'identity.birth_date.future');
$assert(IdentityDocumentValidator::birthDate('2000-01-01'), 'identity.birth_date.valid');

$same(null, FinancialMovementMutationPolicy::target('SELECT * FROM pi_financial_movements', []), 'financial.unrelated_sql');
$target = FinancialMovementMutationPolicy::target(
    'UPDATE pi_financial_movements SET status=?, updated_at=? WHERE clinic_id=? AND id=?',
    ['ok', '2026-08-10 00:00:00', 7, 91],
);
$same('clinic_id=? AND id=?', $target['where'] ?? null, 'financial.update_where');
$same([7, 91], $target['params'] ?? null, 'financial.update_where_params');
$target = FinancialMovementMutationPolicy::target(
    'DELETE FROM pi_financial_movements WHERE clinic_id=? AND id=?',
    [7, 91],
);
$same('clinic_id=? AND id=?', $target['where'] ?? null, 'financial.delete_where');
$same([7, 91], $target['params'] ?? null, 'financial.delete_where_params');

$machine = new StateMachine(
    ['novo' => ['ativo'], 'ativo' => ['finalizado'], 'finalizado' => []],
    ['new' => 'novo', 'done' => 'finalizado'],
    ['novo'],
);
$same('novo', $machine->normalize(' NEW '), 'state.normalize_alias');
$assert($machine->acceptsInitial('new'), 'state.initial_alias');
$assert($machine->canTransition('novo', 'ativo'), 'state.allowed_transition');
$assert(!$machine->canTransition('novo', 'finalizado'), 'state.blocked_transition');
$assert($machine->canTransition('done', 'finalizado'), 'state.same_known_state');
$same(['finalizado'], $machine->allowedFrom('ativo'), 'state.allowed_from');

$routeTest = RouteRegistry::logicSelfTest();
$assert(($routeTest['ok'] ?? false) === true, 'routes.logic_self_test');
$same(63, $routeTest['routes'] ?? null, 'routes.count');
$same(8, $routeTest['public_routes'] ?? null, 'routes.public_count');
$same(9, $routeTest['json_routes'] ?? null, 'routes.json_count');
$login = RouteRegistry::definition('login');
$assert($login !== null && $login->public && $login->isPublicLight('POST'), 'routes.login_public_light');
$reauth = RouteRegistry::definition('global_reauth');
$assert($reauth !== null && !$reauth->public && $reauth->handlerMethod === 'page_global_reauth', 'routes.reauth_protected');
$patient = RouteRegistry::definition('patient');
$same(['patients', 'financial'], $patient?->moduleGroups, 'routes.patient_module_groups');

$cashPort = new class implements FinancialCashierAttentionPort {
    public int $assignedCalls = 0;
    public int $openCalls = 0;
    public bool $assigned = true;
    public bool $open = true;
    public array $lastAssigned = [];
    public array $lastOpen = [];
    public function hasAssignedPosition(int $clinicId, int $userId): bool
    {
        $this->assignedCalls++;
        $this->lastAssigned = [$clinicId, $userId];
        return $this->assigned;
    }
    public function hasOpenSessionBefore(int $clinicId, int $userId, string $businessDate): bool
    {
        $this->openCalls++;
        $this->lastOpen = [$clinicId, $userId, $businessDate];
        return $this->open;
    }
};
$cashService = new FinancialCashierAttentionService($cashPort);
$context = ['scope' => 'clinic', 'role' => 'recepcionista', 'clinic_id' => 7, 'user' => ['id' => 91]];
$assert(!$cashService->requiresAttention(['scope' => 'global'], false, '2026-08-10'), 'application.cash.scope_short_circuit');
$same(0, $cashPort->assignedCalls, 'application.cash.scope_no_port_call');
$assert(!$cashService->requiresAttention($context, true, '2026-08-10'), 'application.cash.readonly_short_circuit');
$same(0, $cashPort->assignedCalls, 'application.cash.readonly_no_port_call');
$cashPort->assigned = false;
$assert(!$cashService->requiresAttention($context, false, '2026-08-10'), 'application.cash.no_assignment');
$same(1, $cashPort->assignedCalls, 'application.cash.assignment_called');
$same(0, $cashPort->openCalls, 'application.cash.open_short_circuit');
$cashPort->assigned = true;
$assert($cashService->requiresAttention($context, false, '2026-08-10'), 'application.cash.requires_attention');
$same([7, 91], $cashPort->lastAssigned, 'application.cash.assignment_context');
$same([7, 91, '2026-08-10'], $cashPort->lastOpen, 'application.cash.open_context');

$patientPort = new class implements PatientReadPort {
    public ?array $registration = ['id' => 31, 'name' => 'Ana'];
    public array $guardians = [];
    public bool $hasGuardian = false;
    public int $registrationCalls = 0;
    public function appointmentRegistration(int $clinicId, int $patientId): ?array
    {
        $this->registrationCalls++;
        return $this->registration;
    }
    public function activeLegalGuardians(int $clinicId, int $patientId): array
    {
        return $this->guardians;
    }
    public function hasActiveLegalGuardian(int $clinicId, int $patientId): bool
    {
        return $this->hasGuardian;
    }
};
$patientService = new PatientReadService($patientPort);
$same(null, $patientService->appointmentRegistrationBlockReason(0, 31, static fn(array $row): bool => true, static fn(array $row): string => 'x'), 'application.patient.invalid_context');
$same(0, $patientPort->registrationCalls, 'application.patient.invalid_context_no_port_call');
$same(null, $patientService->appointmentRegistrationBlockReason(7, 31, static fn(array $row): bool => true, static fn(array $row): string => 'x'), 'application.patient.complete_registration');
$patientPort->registration = null;
$same('Paciente não encontrado no consultório atual.', $patientService->appointmentRegistrationBlockReason(7, 31, static fn(array $row): bool => true, static fn(array $row): string => 'x'), 'application.patient.not_found');
$patientPort->registration = ['id' => 31, 'name' => 'Ana'];
$same('Cadastro incompleto', $patientService->appointmentRegistrationBlockReason(7, 31, static fn(array $row): bool => false, static fn(array $row): string => 'Cadastro incompleto'), 'application.patient.block_reason');
$patientPort->guardians = [['id' => '5', 'cpf' => '123.456.789-09', 'relationship' => 'MAE', 'is_primary' => '1']];
$guardians = $patientService->legalGuardians(7, 31, static fn(string $value): string => preg_replace('/\D+/', '', $value) ?? '', static fn(string $value): string => strtolower($value));
$same([['id' => 5, 'cpf' => '12345678909', 'relationship' => 'mae', 'is_primary' => 1]], $guardians, 'application.patient.guardian_normalization');
$patientPort->hasGuardian = true;
$assert($patientService->hasLegalGuardian(7, 31), 'application.patient.has_guardian');

$result = [
    'ok' => $failures === [],
    'policy' => 'fast-unit-suite-v2',
    'assertions_passed' => $passed,
    'assertions_failed' => count($failures),
    'application_ports_tested' => 2,
    'failures' => $failures,
];
fwrite(STDOUT, json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . PHP_EOL);
exit($failures === [] ? 0 : 1);
