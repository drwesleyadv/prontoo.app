#!/usr/bin/env python3
from pathlib import Path

path=Path('tools/presentation-duplicate-rule-reduce')
source=path.read_text()
start=source.index('def collect(rules, context, rows, offsets, source):')
end=source.index('\ndef duplicate_selector_headers', start)
replacement=r'''def scan_rule_end(source: str, start: int) -> int:
    depth=0
    quote=None
    escape=False
    comment=False
    opened=False
    index=start
    while index < len(source):
        char=source[index]
        nxt=source[index+1] if index+1 < len(source) else ''
        if comment:
            if char=='*' and nxt=='/':
                comment=False
                index+=2
                continue
            index+=1
            continue
        if quote is not None:
            if escape:
                escape=False
            elif char=='\\':
                escape=True
            elif char==quote:
                quote=None
            index+=1
            continue
        if char=='/' and nxt=='*':
            comment=True
            index+=2
            continue
        if char in ('"', "'"):
            quote=char
            index+=1
            continue
        if char=='{':
            depth+=1
            opened=True
        elif char=='}' and opened:
            depth-=1
            if depth==0:
                return index+1
        index+=1
    fail(f'unterminated raw CSS rule from offset {start}')


def collect(rules, context, rows, offsets, source):
    for rule in rules:
        if rule.type == 'qualified-rule':
            start=offset_for(rule,offsets)
            end=scan_rule_end(source,start)
            raw=source[start:end]
            body=tinycss2.serialize(rule.content)
            rows.append({
                'context':tuple(context),
                'selector':normalize_selector(rule.prelude),
                'body':body,
                'raw':raw,
                'start':start,
                'end':end,
                'important':raw.count('!important'),
                'route_scopes':normalize_selector(rule.prelude).count('body[data-route='),
            })
        elif rule.type == 'at-rule' and rule.content is not None and str(rule.lower_at_keyword) in RULE_LIST_AT:
            prelude=' '.join(tinycss2.serialize(rule.prelude).split())
            inner=tinycss2.parse_rule_list(rule.content,skip_whitespace=False,skip_comments=False)
            collect(inner,context+((str(rule.lower_at_keyword),prelude),),rows,offsets,source)

'''
path.write_text(source[:start]+replacement+source[end+1:])
