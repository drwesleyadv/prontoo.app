def dedupe_selector_prelude(tokens, stats: dict[str, int]):
    parts = []
    current = []
    for token in tokens:
        if token.type == 'literal' and getattr(token, 'value', None) == ',':
            parts.append(current)
            current = []
        else:
            current.append(token)
    parts.append(current)
    if len(parts) < 2:
        return tokens
    unique = []
    seen = set()
    removed = 0
    for part in parts:
        text = tinycss2.serialize(part).strip()
        if text and text in seen:
            removed += 1
            continue
        if text:
            seen.add(text)
        unique.append(text)
    if removed == 0:
        return tokens
    stats['duplicate_selectors_removed'] += removed
    return tinycss2.parse_component_value_list(','.join(unique))


def transform_rules(rules, stats: dict[str, int]):
