<?php
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit(1);
}

$mode = $argv[1] ?? '--check';
if (!in_array($mode, ['--check', '--write'], true)) {
    fwrite(STDERR, "Uso: php tools/release-contract-reconcile [--check|--write]\n");
    exit(2);
}

$root = dirname(__DIR__);
$readJson = static function (string $path): array {
    $decoded = json_decode((string) file_get_contents($path), true, 512, JSON_THROW_ON_ERROR);
    if (!is_array($decoded)) {
        throw new RuntimeException('Contrato JSON inválido: ' . $path);
    }
    return $decoded;
};
$encodeJson = static fn(array $value): string => json_encode(
    $value,
    JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR,
) . PHP_EOL;
$syncConstant = static function (string $source, string $name, string $value): string {
    $pattern = '/const\s+' . preg_quote($name, '/') . '\s*=\s*["\x27][^"\x27]+["\x27]\s*;/';
    $replacement = 'const ' . $name . ' = "' . $value . '";';
    $updated = preg_replace($pattern, $replacement, $source, 1, $count);
    if (!is_string($updated) || $count !== 1) {
        throw new RuntimeException('Fallback canônico não localizado: ' . $name);
    }
    return $updated;
};
$canonicalChangelog = static function (string $source, string $release, array $version): string {
    $changelog = (array) ($version['changelog'] ?? []);
    $title = mb_trim((string) ($changelog['title'] ?? ''));
    $items = array_values(array_filter(
        array_map(static fn(mixed $item): string => mb_trim((string) $item), (array) ($changelog['items'] ?? [])),
        static fn(string $item): bool => $item !== '',
    ));
    if ($title === '' || $items === []) {
        throw new RuntimeException('Bloco canônico de changelog ausente em version.json.');
    }
    $prefix = '# Histórico de versões' . PHP_EOL;
    if (!str_starts_with($source, $prefix)) {
        throw new RuntimeException('Cabeçalho canônico do CHANGELOG.md ausente.');
    }
    $heading = '## ' . $release . ' — ' . $title;
    $body = implode(PHP_EOL, array_map(
        static fn(string $item): string => '- ' . rtrim($item, '.') . '.',
        $items,
    ));
    $entry = $heading . PHP_EOL . PHP_EOL . $body . PHP_EOL;
    $sectionPattern = '/^##\s+' . preg_quote($release, '/') . '\s+—[^\n]*\n.*?(?=^##\s+|\z)/ms';
    if (preg_match($sectionPattern, $source) === 1) {
        $updated = preg_replace_callback(
            $sectionPattern,
            static fn(array $match): string => $entry . PHP_EOL,
            $source,
            1,
            $count,
        );
        if (!is_string($updated) || $count !== 1) {
            throw new RuntimeException('Falha ao reconciliar entrada existente do CHANGELOG.md.');
        }
    } else {
        $updated = $prefix . PHP_EOL . $entry . substr($source, strlen($prefix));
    }
    $updated = preg_replace(
        '/^##\s+Não publicado[^\n]*\n.*?(?=^##\s+|\z)/ms',
        '',
        $updated,
    );
    if (!is_string($updated)) {
        throw new RuntimeException('Falha ao consumir o bloco não publicado do CHANGELOG.md.');
    }
    return $updated;
};

$documentationWorkflow = <<<'YAML'
name: Documentation Contract

on:
  pull_request:
  push:
    branches:
      - prontoo

permissions:
  contents: read

jobs:
  validate:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Setup PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: '8.4'
          coverage: none
          tools: none
      - name: Deterministic release contract
        shell: bash
        run: |
          set -euo pipefail
          php tools/release-contract-reconcile --check
      - name: Validate documentation contract
        shell: bash
        run: |
          set -euo pipefail
          while IFS= read -r -d '' file; do
            php -l "$file" >/dev/null
          done < <(find . \
            -path './.git' -prune -o \
            -path './ssd' -prune -o \
            -path './vendor' -prune -o \
            -path './node_modules' -prune -o \
            -name '*.php' -print0)
          php tools/documentation-check.php
          php tools/code-comment-check.php
          php tools/security-regression-check.php
YAML;
$documentationWorkflow .= PHP_EOL;

$architectureWorkflowPath = $root . '/.github/workflows/architecture.yml';
$architectureWorkflow = (string) file_get_contents($architectureWorkflowPath);
$architectureNeedle = "          php tools/version-asset-contract-check.php\n          php tools/php84-runtime-contract-check\n";
$architectureCheck = "          php tools/release-contract-reconcile --check\n";
$qualityGateCheck = "          php tools/quality-gate\n";
$architectureCheckCount = substr_count($architectureWorkflow, $architectureCheck);
$qualityGateCheckCount = substr_count($architectureWorkflow, $qualityGateCheck);
if ($architectureCheckCount === 0 && $qualityGateCheckCount === 0) {
    $needleCount = substr_count($architectureWorkflow, $architectureNeedle);
    if ($needleCount !== 1) {
        throw new RuntimeException('Ponto canônico do release contract não foi localizado no Architecture Contract.');
    }
    $architectureWorkflow = str_replace(
        $architectureNeedle,
        $architectureNeedle . $architectureCheck,
        $architectureWorkflow,
    );
} elseif ($architectureCheckCount > 1 || $qualityGateCheckCount > 1 || ($architectureCheckCount === 1 && $qualityGateCheckCount === 1)) {
    throw new RuntimeException('Architecture Contract contém release check canônico duplicado.');
}

$versionPath = $root . '/version.json';
$manifestPath = $root . '/app/update.manifest.json';
$architecturePath = $root . '/app/architecture.manifest.json';
$prontooPath = $root . '/app/prontoo.php';
$landingPath = $root . '/br/index.php';
$changelogPath = $root . '/CHANGELOG.md';

$version = $readJson($versionPath);
$manifest = $readJson($manifestPath);
$architecture = $readJson($architecturePath);
$release = mb_trim((string) ($version['version'] ?? ''));
$previous = mb_trim((string) ($version['previous_version'] ?? ''));
if ($release === '' || mb_trim((string) ($version['release'] ?? '')) !== $release || $previous === '') {
    throw new RuntimeException('Metadados canônicos de release inválidos.');
}
if (mb_trim((string) ($version['updated_at'] ?? '')) === '') {
    throw new RuntimeException('updated_at determinístico ausente em version.json.');
}

$prontoo = $syncConstant((string) file_get_contents($prontooPath), 'PRONTOO_VERSION_FALLBACK', $release);
$prontoo = $syncConstant($prontoo, 'PRONTOO_PREVIOUS_VERSION', $previous);
$landing = $syncConstant((string) file_get_contents($landingPath), 'BR_LANDING_VERSION_FALLBACK', $release);
$changelog = $canonicalChangelog((string) file_get_contents($changelogPath), $release, $version);

foreach ([
    'version' => 'version',
    'release' => 'release',
    'build' => 'build',
    'generated_at' => 'generated_at',
    'updated_at' => 'updated_at',
    'previous_version' => 'previous_version',
    'deployment_sync_id' => 'deployment_sync_id',
    'logic_changes' => 'logic_changes',
    'documentation_changes' => 'documentation_changes',
    'database_changes' => 'database_changes',
    'schema_changes' => 'schema_changes',
    'visual_changes' => 'visual_changes',
    'runtime_readiness_policy' => 'runtime_readiness_policy',
    'release_reconciliation_policy' => 'release_reconciliation_policy',
] as $target => $sourceKey) {
    if (array_key_exists($sourceKey, $version)) {
        $architecture[$target] = $version[$sourceKey];
    }
}
$architecture['policy'] = (string) ($version['architecture_policy'] ?? $architecture['policy'] ?? '');
$architecture['native_files_min'] = (int) ($version['architecture_native_files_min'] ?? 0);
$architecture['transitional_files_max'] = (int) ($version['architecture_transitional_files_max'] ?? 0);
$architecture['native_migration_policy'] = 'effective_native_unit_count_must_not_decrease_and_current_non_native_ceiling_must_not_increase';
$architectureContent = $encodeJson($architecture);

foreach ([
    'version',
    'release',
    'schema_revision',
    'build',
    'package_type',
    'generated_at',
    'version_format',
    'minimum_php',
    'database_changes',
    'schema_changes',
    'logic_changes',
    'visual_changes',
    'documentation_changes',
    'clean_install_schema',
    'requires_empty_database',
    'architecture_policy',
    'architecture_native_files_min',
    'architecture_transitional_files_max',
    'installer_locked',
    'installer_access_policy',
    'post_window_policy',
    'asset_version',
    'required_php_family',
    'previous_version',
    'deployment_sync_id',
    'release_date',
] as $key) {
    if (array_key_exists($key, $version)) {
        $manifest[$key] = $version[$key];
    }
}
$manifest['release'] = $release;
$manifest['version'] = $release;
$manifest['installer'] = array_replace(
    (array) ($manifest['installer'] ?? []),
    [
        'locked' => (bool) ($version['installer_locked'] ?? true),
        'access_policy' => (string) ($version['installer_access_policy'] ?? 'disabled_by_default'),
        'post_window_policy' => (string) ($version['post_window_policy'] ?? 'locked_after_installation'),
    ],
);
$manifest['architecture'] = array_replace(
    (array) ($manifest['architecture'] ?? []),
    [
        'policy' => (string) ($version['architecture_policy'] ?? ''),
        'native_files_min' => (int) ($version['architecture_native_files_min'] ?? 0),
        'transitional_files_max' => (int) ($version['architecture_transitional_files_max'] ?? 0),
        'runtime_readiness_policy' => (string) ($version['runtime_readiness_policy'] ?? ''),
        'release_reconciliation_policy' => (string) ($version['release_reconciliation_policy'] ?? ''),
    ],
);

$manifestFiles = [];
$iterator = new RecursiveIteratorIterator(
    new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS),
);
$rootPrefix = rtrim(str_replace('\\', '/', $root), '/') . '/';
foreach ($iterator as $file) {
    if (!$file instanceof SplFileInfo || !$file->isFile()) {
        continue;
    }
    $absolute = str_replace('\\', '/', $file->getPathname());
    $relative = str_starts_with($absolute, $rootPrefix)
        ? substr($absolute, strlen($rootPrefix))
        : $absolute;
    if ($relative === '' || str_starts_with($relative, '.git/') || str_starts_with($relative, 'ssd/') || str_starts_with($relative, 'vendor/') || str_starts_with($relative, 'node_modules/')) {
        continue;
    }
    if ($relative === 'app/update.manifest.json') {
        continue;
    }
    $manifestFiles[$relative] = hash_file('sha256', $absolute);
}
ksort($manifestFiles, SORT_STRING);
$manifest['files'] = $manifestFiles;
$manifestContent = $encodeJson($manifest);

$expected = [
    $architectureWorkflowPath => $architectureWorkflow,
    $root . '/.github/workflows/documentation.yml' => $documentationWorkflow,
    $prontooPath => $prontoo,
    $landingPath => $landing,
    $changelogPath => $changelog,
    $architecturePath => $architectureContent,
    $manifestPath => $manifestContent,
];

if ($mode === '--write') {
    foreach ($expected as $path => $content) {
        if ((string) @file_get_contents($path) !== $content) {
            file_put_contents($path, $content);
        }
    }
    fwrite(STDOUT, json_encode([
        'ok' => true,
        'mode' => 'write',
        'policy' => 'deterministic-release-contract-v1',
        'release' => $release,
        'outputs' => array_map(
            static fn(string $path): string => str_replace($rootPrefix, '', str_replace('\\', '/', $path)),
            array_keys($expected),
        ),
        'file_count' => count($manifestFiles),
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . PHP_EOL);
    exit(0);
}

$failures = [];
foreach ($expected as $path => $content) {
    if ((string) @file_get_contents($path) !== $content) {
        $relative = str_replace($rootPrefix, '', str_replace('\\', '/', $path));
        $failures[] = $relative;
    }
}
if ($failures !== []) {
    fwrite(STDERR, json_encode([
        'ok' => false,
        'mode' => 'check',
        'policy' => 'deterministic-release-contract-v1',
        'release' => $release,
        'drift' => $failures,
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . PHP_EOL);
    exit(1);
}

fwrite(STDOUT, json_encode([
    'ok' => true,
    'mode' => 'check',
    'policy' => 'deterministic-release-contract-v1',
    'release' => $release,
    'outputs' => array_map(
        static fn(string $path): string => str_replace($rootPrefix, '', str_replace('\\', '/', $path)),
        array_keys($expected),
    ),
    'file_count' => count($manifestFiles),
    'deterministic_updated_at' => (string) ($version['updated_at'] ?? ''),
], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . PHP_EOL);
