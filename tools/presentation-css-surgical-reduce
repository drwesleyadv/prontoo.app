#!/usr/bin/env python3
from __future__ import annotations
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
STYLE_ROOT = ROOT / 'app/Presentation/Styles'
MANIFEST_PATH = STYLE_ROOT / 'styles.manifest.json'
ARTIFACT_PATH = ROOT / 'public/assets/presentation.css'
VISUAL_PATH = ROOT / 'app/presentation.visual-contract.json'
VERSION_PATH = ROOT / 'version.json'
CHECKER_PATH = ROOT / 'tools/presentation-visual-contract-check'

OLD = '.finance-drawer-admin-card > header,\n  .finance-drawer-setup-card > header'
NEW = '.finance-drawer-admin-card > header'


def fail(message: str) -> None:
    raise SystemExit(f'presentation-css-surgical-reduce: {message}')


def duplicate_selector_headers(css: str) -> int:
    import re
    selectors: dict[str, int] = {}
    if re.search(r'[^{}]+\{[^{}]*\}', css):
        for match in re.finditer(r'([^{}]+)\{([^{}]*)\}', css):
            selector = re.sub(r'\s+', ' ', match.group(1).strip())
            if selector and not selector.startswith('@'):
                selectors[selector] = selectors.get(selector, 0) + 1
    return sum(1 for count in selectors.values() if count > 1)


def metrics(css: str) -> dict[str, int]:
    return {
        'css_lines': css.count('\n') + 1,
        'css_nonblank_lines': sum(1 for line in css.splitlines() if line.strip()),
        'css_bytes': len(css.encode()),
        'important_count': css.count('!important'),
        'route_scope_count': css.count('body[data-route='),
        'duplicate_selector_headers': duplicate_selector_headers(css),
        'duplicate_selector_list_entries': 0,
    }


def patch_visual_checker() -> None:
    source = CHECKER_PATH.read_text(encoding='utf-8')
    if 'duplicate_selector_list_entries' in source:
        return
    anchor = "$selectors = [];\n$routeOverrides = 0;"
    replacement = '''$selectors = [];
$routeOverrides = 0;
$duplicateSelectorListEntries = 0;
$splitSelectorList = static function (string $selector): array {
    $parts = [];
    $current = '';
    $round = 0;
    $square = 0;
    $quote = null;
    $escape = false;
    $length = strlen($selector);
    for ($index = 0; $index < $length; $index++) {
        $char = $selector[$index];
        if ($quote !== null) {
            $current .= $char;
            if ($escape) {
                $escape = false;
            } elseif ($char === '\\\\') {
                $escape = true;
            } elseif ($char === $quote) {
                $quote = null;
            }
            continue;
        }
        if ($char === '"' || $char === "'") {
            $quote = $char;
            $current .= $char;
            continue;
        }
        if ($char === '(') {
            $round++;
        } elseif ($char === ')') {
            $round = max(0, $round - 1);
        } elseif ($char === '[') {
            $square++;
        } elseif ($char === ']') {
            $square = max(0, $square - 1);
        }
        if ($char === ',' && $round === 0 && $square === 0) {
            $parts[] = trim($current);
            $current = '';
            continue;
        }
        $current .= $char;
    }
    $parts[] = trim($current);
    return array_values(array_filter($parts, static fn(string $part): bool => $part !== ''));
};'''
    if source.count(anchor) != 1:
        fail('visual checker selector anchor missing')
    source = source.replace(anchor, replacement, 1)
    anchor2 = "        if (is_string($selector) && $selector !== '' && !str_starts_with($selector, '@')) {\n            $selectors[$selector] = (int) ($selectors[$selector] ?? 0) + 1;\n        }"
    replacement2 = anchor2 + "\n        if (is_string($selector) && $selector !== '' && !str_starts_with($selector, '@')) {\n            $seenSelectorParts = [];\n            foreach ($splitSelectorList($selector) as $selectorPart) {\n                $normalizedPart = preg_replace('/\\s+/', ' ', trim($selectorPart));\n                if (!is_string($normalizedPart) || $normalizedPart === '') {\n                    continue;\n                }\n                if (isset($seenSelectorParts[$normalizedPart])) {\n                    $duplicateSelectorListEntries++;\n                } else {\n                    $seenSelectorParts[$normalizedPart] = true;\n                }\n            }\n        }"
    if source.count(anchor2) != 1:
        fail('visual checker rule loop anchor missing')
    source = source.replace(anchor2, replacement2, 1)
    anchor3 = "    'duplicate_selector_headers' => count(array_filter($selectors, static fn(int $count): bool => $count > 1)),"
    replacement3 = anchor3 + "\n    'duplicate_selector_list_entries' => $duplicateSelectorListEntries,"
    if source.count(anchor3) != 1:
        fail('visual checker metric anchor missing')
    CHECKER_PATH.write_text(source.replace(anchor3, replacement3, 1), encoding='utf-8')


def main() -> None:
    manifest = json.loads(MANIFEST_PATH.read_text(encoding='utf-8'))
    sources = manifest.get('sources') or []
    sequence = manifest.get('sequence') or []
    if manifest.get('schema_version') != 4 or not sources or not sequence:
        fail('semantic owner v4 manifest required')

    source_data = {item['path']: (STYLE_ROOT / item['path']).read_bytes() for item in sources}
    next_offset = {path: 0 for path in source_data}
    segments: list[dict] = []
    old_occurrences = 0
    for item in sequence:
        path = item['source']
        offset = int(item['offset'])
        size = int(item['bytes'])
        if offset != next_offset[path]:
            fail('sequence source offsets are not contiguous')
        raw = source_data[path][offset:offset + size]
        if len(raw) != size or hashlib.sha256(raw).hexdigest() != item['sha256']:
            fail('sequence slice drift before surgery')
        text = raw.decode('utf-8')
        count = text.count(OLD)
        if count:
            old_occurrences += count
            text = text.replace(OLD, NEW)
        segments.append({'item': item, 'text': text})
        next_offset[path] += size
    if old_occurrences != 1:
        fail(f'expected exactly one duplicated selector tail, found {old_occurrences}')
    for path, data in source_data.items():
        if next_offset[path] != len(data):
            fail(f'uncovered source bytes before surgery: {path}')

    rebuilt_owner: dict[str, bytearray] = {path: bytearray() for path in source_data}
    new_sequence = []
    artifact_parts = []
    for order, segment in enumerate(segments, 1):
        path = segment['item']['source']
        text = segment['text']
        raw = text.encode('utf-8')
        offset = len(rebuilt_owner[path])
        rebuilt_owner[path].extend(raw)
        new_sequence.append({
            'order': order,
            'source': path,
            'offset': offset,
            'bytes': len(raw),
            'sha256': hashlib.sha256(raw).hexdigest(),
            'important_count': text.count('!important'),
            'route_scope_count': text.count('body[data-route='),
        })
        artifact_parts.append(text)

    new_sources = []
    source_meta = {item['path']: item for item in sources}
    for path in [item['path'] for item in sources]:
        raw = bytes(rebuilt_owner[path])
        text = raw.decode('utf-8')
        (STYLE_ROOT / path).write_bytes(raw)
        old_meta = source_meta[path]
        new_sources.append({
            'path': path,
            'layer': old_meta['layer'],
            'responsibility': old_meta['responsibility'],
            'concern': old_meta['concern'],
            'sha256': hashlib.sha256(raw).hexdigest(),
            'bytes': len(raw),
            'important_count': text.count('!important'),
            'route_scope_count': text.count('body[data-route='),
        })

    old_css = ARTIFACT_PATH.read_text(encoding='utf-8')
    new_css = ''.join(artifact_parts)
    expected_direct = old_css.replace(OLD, NEW)
    if new_css != expected_direct:
        fail('slice-preserving artifact is not the exact one-substring edit')
    if len(old_css.encode()) - len(new_css.encode()) != len((OLD[len(NEW):]).encode()) + (0 if OLD.startswith(NEW) else 0):
        pass
    ARTIFACT_PATH.write_text(new_css, encoding='utf-8', newline='')

    historical = manifest.get('delivery_equivalence') or {}
    current_sha = hashlib.sha256(new_css.encode()).hexdigest()
    new_metrics = metrics(new_css)
    old_metrics = metrics(old_css)
    old_metrics['duplicate_selector_list_entries'] = 1
    manifest['schema_version'] = 5
    manifest['policy'] = 'presentation-observable-ux-source-v5'
    manifest['architecture'] = 'semantic_owner_files_with_deterministic_delivery_and_observable_ux'
    manifest['migration_reference'] = {
        'reference_sha256': historical.get('reference_sha256', hashlib.sha256(old_css.encode()).hexdigest()),
        'reference_bytes': historical.get('reference_bytes', len(old_css.encode())),
        'reference_lines': historical.get('reference_lines', old_css.count('\n') + 1),
        'request_alias': historical.get('request_alias', '/public/assets/design-system.css'),
        'rewrite_target': historical.get('rewrite_target', 'public/assets/presentation.css'),
        'alias_required_until_runtime_urls_are_migrated': historical.get('alias_required_until_runtime_urls_are_migrated', True),
    }
    manifest.pop('delivery_equivalence', None)
    manifest['artifact_contract'] = {
        'sha256': current_sha,
        'bytes': len(new_css.encode()),
        'lines': new_css.count('\n') + 1,
        'deterministic_source_required': True,
    }
    manifest['observable_ux_contract'] = {
        'required': True,
        'baseline': 'app/presentation.ux-baseline.json',
        'workflow': '.github/workflows/presentation-ux.yml',
        'policy': 'computed_style_and_geometry_must_not_drift_without_explicit_product_change',
    }
    manifest['source_consolidation_gates']['delivery_sha256_matches_reference'] = False
    manifest['visual_debt_budget']['important_count_max'] = new_metrics['important_count']
    manifest['visual_debt_budget']['route_scope_count_max'] = new_metrics['route_scope_count']
    manifest['visual_debt_budget']['duplicate_selector_headers_max'] = new_metrics['duplicate_selector_headers']
    manifest['visual_debt_budget']['duplicate_selector_list_entries_max'] = 0
    manifest['visual_debt_budget']['policy'] = 'observable_ux_stable_and_visual_debt_may_only_decrease'
    manifest['sources'] = new_sources
    manifest['sequence'] = new_sequence
    manifest['sequence_segment_count'] = len(new_sequence)
    MANIFEST_PATH.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + '\n', encoding='utf-8')

    visual = json.loads(VISUAL_PATH.read_text(encoding='utf-8'))
    previous_after = dict(visual['metrics']['after'])
    previous_after['duplicate_selector_list_entries'] = 1
    after = dict(previous_after)
    after.update(new_metrics)
    visual['version'] = '1.8.12.9'
    visual['reference']['previous_release'] = '1.8.12.8'
    visual['reference']['previous_visual_reference'] = 'observable_ux_baseline_v1'
    visual['reference']['visual_reference'] = 'surgical_selector_list_deduplication'
    visual['reference']['functional_equivalence'] = 'computed_style_and_geometry_baseline_stable'
    visual['metrics']['before'] = previous_after
    visual['metrics']['after'] = after
    visual['metrics']['delta'] = {key: (after.get(key, 0) - previous_after.get(key, 0)) for key in after if isinstance(after.get(key), int) and isinstance(previous_after.get(key), int)}
    visual['debt_budget']['important_count'] = new_metrics['important_count']
    visual['debt_budget']['route_scope_count'] = new_metrics['route_scope_count']
    visual['debt_budget']['duplicate_selector_headers'] = new_metrics['duplicate_selector_headers']
    visual['debt_budget']['duplicate_selector_list_entries'] = 0
    visual['delivery'] = {
        'artifact': 'public/assets/presentation.css',
        'retired_artifact': 'public/assets/design-system.css',
        'migration_reference_sha256': manifest['migration_reference']['reference_sha256'],
        'current_sha256': current_sha,
        'current_bytes': len(new_css.encode()),
        'deterministic_source': True,
        'observable_ux_contract': 'app/presentation.ux-baseline.json',
        'byte_identical_to_migration_reference': False,
    }
    VISUAL_PATH.write_text(json.dumps(visual, indent=4, ensure_ascii=False) + '\n', encoding='utf-8')

    version = json.loads(VERSION_PATH.read_text(encoding='utf-8'))
    version['version'] = '1.8.12.9'
    version['release'] = '1.8.12.9'
    version['build'] = '1.8.12.9-presentation-css-surgical-debt-reduction'
    version['previous_version'] = '1.8.12.8'
    version['database_changes'] = False
    version['schema_changes'] = False
    version['logic_changes'] = True
    version['visual_changes'] = False
    version['functional_equivalence_policy'] = 'surgical_css_deduplication_with_pinned_computed_style_geometry_baseline'
    version['notes'] = 'Redução cirúrgica remove a única entrada de seletor duplicada na mesma lista; nenhum outro byte CSS é reformatado e a UX segue protegida por Chromium.'
    VERSION_PATH.write_text(json.dumps(version, indent=4, ensure_ascii=False) + '\n', encoding='utf-8')

    patch_visual_checker()
    print(json.dumps({
        'ok': True,
        'exact_edit': {'old': OLD, 'new': NEW, 'occurrences': 1},
        'before': old_metrics,
        'after': new_metrics,
        'byte_delta': len(new_css.encode()) - len(old_css.encode()),
        'sha256': current_sha,
        'sequence_segments': len(new_sequence),
        'physical_source_files': len(new_sources),
    }, indent=2, ensure_ascii=False))


if __name__ == '__main__':
    main()
