#!/usr/bin/env python3
import json
import re
from pathlib import Path
import tinycss2

CSS = Path('public/assets/presentation.css').read_text(encoding='utf-8')
PATTERN = re.compile(r'^(body\[data-route=(?:"[^"]+"|\'[^\']+\')\])\s+(\.[A-Za-z_][A-Za-z0-9_-]*)$')


def split_selector_list(tokens):
    parts=[]; current=[]; round_depth=square_depth=0
    for token in tokens:
        if token.type == '() block':
            current.append(token); continue
        if token.type == '[] block':
            current.append(token); continue
        if token.type == 'literal' and token.value == ',' and round_depth == 0 and square_depth == 0:
            parts.append(current); current=[]
        else:
            current.append(token)
    parts.append(current)
    return parts


def walk(rules, path='root'):
    found=[]
    for rule in rules:
        if rule.type == 'qualified-rule':
            parts=split_selector_list(rule.prelude)
            entries=[]
            for idx, part in enumerate(parts):
                text=tinycss2.serialize(part).strip()
                match=PATTERN.match(text)
                if match:
                    entries.append((idx, match.group(1), match.group(2), text))
            groups={}
            for entry in entries:
                groups.setdefault(entry[1], []).append(entry)
            for prefix, members in groups.items():
                if len(members) >= 2:
                    old=tinycss2.serialize(rule.prelude)
                    found.append({
                        'context':path,
                        'prefix':prefix,
                        'members':[m[2] for m in members],
                        'member_indexes':[m[0] for m in members],
                        'selector_count':len(parts),
                        'old_prelude':old,
                        'route_scope_reduction':len(members)-1,
                    })
        elif rule.type == 'at-rule' and rule.content is not None and str(rule.lower_at_keyword) in {'media','supports','container','layer','scope','starting-style'}:
            inner=tinycss2.parse_rule_list(rule.content, skip_whitespace=False, skip_comments=False)
            found.extend(walk(inner, path + '/@' + str(rule.lower_at_keyword)))
    return found

rules=tinycss2.parse_stylesheet(CSS, skip_whitespace=False, skip_comments=False)
found=walk(rules)
print(json.dumps({
    'candidate_groups':len(found),
    'route_scope_reduction':sum(item['route_scope_reduction'] for item in found),
    'candidates':found,
},indent=2,ensure_ascii=False))
