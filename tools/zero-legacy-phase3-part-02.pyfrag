old = '''        if (str_starts_with($type, "tab_")) {
            $id = (int) substr($type, 4);
            if ($id > 0) {
                try {
                    $label = prontoo_patient_tab_label_by_id($id);
                    if (trim($label) !== "") {
                        return patient_tab_label_clean($label);
                    }
                } catch (Throwable $e) {
                    error_log(
                        "[Prontoo recoverable " .
                            __FUNCTION__ .
                            "] " .
                            $e->getMessage(),
                    );
                }
            }
        }'''


new = '''        if (str_starts_with($type, "tab_") && mb_trim((string) $customTabLabel) !== "") {
            return patient_tab_label_clean((string) $customTabLabel);
        }'''


if old not in source:
    raise SystemExit(f'expected patient Domain resolver not found: {path}')


source = source.replace(old, new, 1)

