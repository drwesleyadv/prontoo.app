#!/usr/bin/env php
<?php
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit(1);
}

$root = dirname(__DIR__);
$tokenPath = $root . '/design/generated/tokens.css';
$artifactPath = $root . '/public/assets/presentation.css';
$layerOrder = [
    'foundation',
    'primitives',
    'components',
    'composition',
    'precedence',
];
$layerPaths = array_map(
    static fn(string $name): string => $root . '/design/styles/' . $name . '.css',
    $layerOrder,
);
$forbiddenPaths = [
    $root . '/design/styles/application.css',
    $root . '/design/styles/standards.css',
    $root . '/app/Presentation/Styles',
    $root . '/design/tokens/css-bridge.json',
];
foreach ($forbiddenPaths as $forbidden) {
    if (file_exists($forbidden)) {
        fwrite(STDERR, "presentation-css-build: noncanonical design source present {$forbidden}\n");
        exit(1);
    }
}
foreach ([$tokenPath, ...$layerPaths] as $required) {
    if (!is_file($required) || (string) file_get_contents($required) === '') {
        fwrite(STDERR, "presentation-css-build: canonical source missing {$required}\n");
        exit(1);
    }
}
$tokens = (string) file_get_contents($tokenPath);
if (str_contains($tokens, '@import') || str_contains($tokens, '!important')) {
    fwrite(STDERR, "presentation-css-build: generated DTCG artifact violates purity contract\n");
    exit(1);
}
$layerSources = [];
foreach ($layerOrder as $index => $name) {
    $source = (string) file_get_contents($layerPaths[$index]);
    if (!str_contains($source, '@layer ds-' . $name)) {
        fwrite(STDERR, "presentation-css-build: layer identity mismatch {$name}\n");
        exit(1);
    }
    if (str_contains($source, '!important') || str_contains($source, 'body[data-route=')) {
        fwrite(STDERR, "presentation-css-build: zero-debt invariant violated {$name}\n");
        exit(1);
    }
    if (preg_match('/--(?!pt-(?:ref|sys|cmp|runtime|presentation)-)[a-z0-9_-]+/i', $source) === 1) {
        fwrite(STDERR, "presentation-css-build: noncanonical custom property namespace {$name}\n");
        exit(1);
    }
    $layerSources[] = $source;
}
$fontImport = '@import url("https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;800&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400..700,0..1,-25..200&display=swap");';
$layerHeader = '@layer ' . implode(', ', array_map(static fn(string $name): string => 'ds-' . $name, $layerOrder)) . ';';
$built = $fontImport . "\n\n" . $tokens . "\n" . $layerHeader . "\n\n" . implode("\n", $layerSources);
if (substr_count($built, '!important') !== 0 || substr_count($built, 'body[data-route=') !== 0) {
    fwrite(STDERR, "presentation-css-build: built artifact has historical cascade debt\n");
    exit(1);
}
$sha = hash('sha256', $built);
$mode = $argv[1] ?? '--lint';
if ($mode === '--lint') {
    fwrite(STDOUT, json_encode([
        'ok' => true,
        'policy' => 'dtcg-native-contract-driven-layered-zero-debt-v1',
        'dtcg_sources' => 1,
        'layer_sources' => count($layerSources),
        'legacy_sources' => 0,
        'important_count' => 0,
        'route_scope_count' => 0,
        'bytes' => strlen($built),
        'sha256' => $sha,
        'deterministic_source' => true,
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . PHP_EOL);
    exit(0);
}
if ($mode === '--write') {
    if (file_put_contents($artifactPath, $built) === false) {
        fwrite(STDERR, "presentation-css-build: artifact write failed\n");
        exit(1);
    }
    fwrite(STDOUT, "presentation-css-build: artifact written {$sha}\n");
    exit(0);
}
if ($mode === '--check') {
    $current = is_file($artifactPath) ? (string) file_get_contents($artifactPath) : '';
    if ($current !== $built) {
        fwrite(STDERR, "presentation-css-build: generated artifact drift\n");
        exit(1);
    }
    fwrite(STDOUT, "presentation-css-build: deterministic artifact {$sha}\n");
    exit(0);
}
fwrite(STDERR, "presentation-css-build: use --lint, --check or --write\n");
exit(1);
