#!/usr/bin/env php
<?php
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit(1);
}

$root = dirname(__DIR__);
$tokenPath = $root . '/design/generated/tokens.css';
$applicationPath = $root . '/design/styles/application.css';
$artifactPath = $root . '/public/assets/presentation.css';
$visualPath = $root . '/app/presentation.visual-contract.json';
$legacyStyleRoot = $root . '/app/Presentation/Styles';
$legacyBridge = $root . '/design/tokens/css-bridge.json';

if (is_dir($legacyStyleRoot) || is_file($legacyBridge)) {
    fwrite(STDERR, "presentation-css-build: legacy css architecture present\n");
    exit(1);
}
foreach ([$tokenPath, $applicationPath, $visualPath] as $required) {
    if (!is_file($required)) {
        fwrite(STDERR, "presentation-css-build: source missing {$required}\n");
        exit(1);
    }
}

$tokens = (string) file_get_contents($tokenPath);
$application = (string) file_get_contents($applicationPath);
if ($tokens === '' || $application === '') {
    fwrite(STDERR, "presentation-css-build: empty design source\n");
    exit(1);
}
if (preg_match('/--pt-(?:ref|sys|cmp)-[a-z0-9-]+\s*:/i', $application) === 1) {
    fwrite(STDERR, "presentation-css-build: canonical token authored in application css\n");
    exit(1);
}
if (str_contains($tokens, '@import')) {
    fwrite(STDERR, "presentation-css-build: generated tokens cannot import external css\n");
    exit(1);
}

$fontImport = '@import url("https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;800&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400..700,0..1,-25..200&display=swap");';
if (!str_starts_with($application, $fontImport)) {
    fwrite(STDERR, "presentation-css-build: canonical font import missing\n");
    exit(1);
}
$applicationBody = ltrim(substr($application, strlen($fontImport)), "\r\n");
if (str_contains($applicationBody, '@import')) {
    fwrite(STDERR, "presentation-css-build: additional imports are forbidden\n");
    exit(1);
}
$built = $fontImport . "\n\n" . $tokens . $applicationBody;
$important = substr_count($built, '!important');
$routes = substr_count($built, 'body[data-route=');

try {
    $visual = json_decode((string) file_get_contents($visualPath), true, 512, JSON_THROW_ON_ERROR);
} catch (Throwable $error) {
    fwrite(STDERR, "presentation-css-build: invalid visual contract\n");
    exit(1);
}
$budget = is_array($visual['debt_budget'] ?? null) ? $visual['debt_budget'] : [];
if ($important > (int) ($budget['important_count'] ?? -1) || $routes > (int) ($budget['route_scope_count'] ?? -1)) {
    fwrite(STDERR, "presentation-css-build: visual debt budget increased\n");
    exit(1);
}

$sha = hash('sha256', $built);
$mode = $argv[1] ?? '--lint';
if ($mode === '--lint') {
    fwrite(STDOUT, json_encode([
        'ok' => true,
        'policy' => 'design-source-direct-concatenation-v1',
        'physical_source_files' => 2,
        'sequence_segments' => 0,
        'bytes' => strlen($built),
        'sha256' => $sha,
        'important_count' => $important,
        'route_scope_count' => $routes,
        'legacy_source_files' => 0,
        'manifest_bytes' => 0,
        'font_imports' => 1,
        'deterministic_source' => true,
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . PHP_EOL);
    exit(0);
}
if ($mode === '--write') {
    if (file_put_contents($artifactPath, $built) === false) {
        fwrite(STDERR, "presentation-css-build: artifact write failed\n");
        exit(1);
    }
    fwrite(STDOUT, "presentation-css-build: artifact written {$sha}\n");
    exit(0);
}
if ($mode === '--check') {
    $current = is_file($artifactPath) ? (string) file_get_contents($artifactPath) : '';
    if ($current !== $built) {
        fwrite(STDERR, "presentation-css-build: generated artifact drift\n");
        exit(1);
    }
    fwrite(STDOUT, "presentation-css-build: deterministic artifact {$sha}\n");
    exit(0);
}
fwrite(STDERR, "presentation-css-build: use --lint, --check or --write\n");
exit(1);
