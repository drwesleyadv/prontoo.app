#!/usr/bin/env php
<?php
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit(1);
}
$root = dirname(__DIR__);
$contract = json_decode((string) file_get_contents($root . '/app/presentation.visual-contract.json'), true, 512, JSON_THROW_ON_ERROR);
$css = (string) file_get_contents($root . '/public/assets/presentation.css');
$js = (string) file_get_contents($root . '/public/assets/app.js');
$rt2 = (string) file_get_contents($root . '/app/Runtime/UiComponents/UiComponentsRuntimeOperations02.php');
$rt3 = (string) file_get_contents($root . '/app/Runtime/UiComponents/UiComponentsRuntimeOperations03.php');
$rendererPath = $root . '/app/Presentation/UiComponents/PageHeadControlPresentationOperations01.php';
$renderer = is_file($rendererPath) ? (string) file_get_contents($rendererPath) : '';
$adminClinicsPresentation = (string) file_get_contents($root . '/app/Presentation/AdminPages/AdminPagesPresentationOperations03.php');
$adminClinicsRuntime = (string) file_get_contents($root . '/app/Runtime/AdminPages/AdminPagesRuntimeOperations08.php');
$applicationRoot = (string) file_get_contents($root . '/app/prontoo.php');
$maestroCron = (string) file_get_contents($root . '/cron/maestro.php');
$php = '';
$iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root . '/app', FilesystemIterator::SKIP_DOTS));
foreach ($iterator as $file) {
    if ($file instanceof SplFileInfo && $file->isFile() && strtolower($file->getExtension()) === 'php') {
        $php .= (string) file_get_contents($file->getPathname());
    }
}
$selectors = [];
$routeOverrides = 0;
$duplicateSelectorListEntries = 0;
$factorableRouteScopeGroups = 0;
$splitSelectorList = static function (string $selector): array {
    $parts = [];
    $current = '';
    $round = 0;
    $square = 0;
    $quote = null;
    $escape = false;
    $length = strlen($selector);
    for ($index = 0; $index < $length; $index++) {
        $char = $selector[$index];
        if ($quote !== null) {
            $current .= $char;
            if ($escape) {
                $escape = false;
            } elseif ($char === '\\') {
                $escape = true;
            } elseif ($char === $quote) {
                $quote = null;
            }
            continue;
        }
        if ($char === '"' || $char === "'") {
            $quote = $char;
            $current .= $char;
            continue;
        }
        if ($char === '(') {
            $round++;
        } elseif ($char === ')') {
            $round = max(0, $round - 1);
        } elseif ($char === '[') {
            $square++;
        } elseif ($char === ']') {
            $square = max(0, $square - 1);
        }
        if ($char === ',' && $round === 0 && $square === 0) {
            $parts[] = trim($current);
            $current = '';
            continue;
        }
        $current .= $char;
    }
    $parts[] = trim($current);
    return array_values(array_filter($parts, static fn(string $part): bool => $part !== ''));
};
if (preg_match_all('/([^{}]+)\{([^{}]*)\}/', $css, $matches, PREG_SET_ORDER)) {
    foreach ($matches as $match) {
        $selector = preg_replace('/\s+/', ' ', trim((string) $match[1]));
        if (is_string($selector) && $selector !== '' && !str_starts_with($selector, '@')) {
            $selectors[$selector] = (int) ($selectors[$selector] ?? 0) + 1;
        }
        if (is_string($selector) && $selector !== '' && !str_starts_with($selector, '@')) {
            $seenSelectorParts = [];
            foreach ($splitSelectorList($selector) as $selectorPart) {
                $normalizedPart = preg_replace('/\s+/', ' ', trim($selectorPart));
                if (!is_string($normalizedPart) || $normalizedPart === '') {
                    continue;
                }
                if (isset($seenSelectorParts[$normalizedPart])) {
                    $duplicateSelectorListEntries++;
                } else {
                    $seenSelectorParts[$normalizedPart] = true;
                }
            }
        }
        if (is_string($selector) && $selector !== '' && !str_starts_with($selector, '@')) {
            $routeGroups = [];
            foreach ($splitSelectorList($selector) as $selectorPart) {
                $normalizedPart = preg_replace('/\s+/', ' ', trim($selectorPart));
                if (is_string($normalizedPart) && preg_match('/^(body\[data-route="[^"]+"\])\s+(\.[A-Za-z_][A-Za-z0-9_-]*)$/', $normalizedPart, $routeMatch)) {
                    $routeGroups[(string) $routeMatch[1]] = (int) ($routeGroups[(string) $routeMatch[1]] ?? 0) + 1;
                }
            }
            foreach ($routeGroups as $routeGroupCount) {
                if ($routeGroupCount >= 2) {
                    $factorableRouteScopeGroups++;
                }
            }
        }
        if (is_string($selector) && str_contains($selector, 'body[data-route=') && str_contains($selector, '.pagehead-control') && preg_match('/(^|;)\s*(min-height|height|padding(?:-[a-z]+)?|gap|border(?:-[a-z]+)?|border-radius|background(?:-[a-z]+)?|color|box-shadow|font(?:-[a-z]+)?|line-height|white-space|align-items|justify-content)\s*:/i', (string) $match[2])) {
            $routeOverrides++;
        }
    }
}
$metrics = [
    'css_lines' => substr_count($css, "\n") + 1,
    'css_nonblank_lines' => count(array_filter(preg_split('/\R/', $css) ?: [], static fn(string $line): bool => trim($line) !== '')),
    'css_bytes' => strlen($css),
    'important_count' => substr_count($css, '!important'),
    'route_scope_count' => substr_count($css, 'body[data-route='),
    'duplicate_selector_headers' => count(array_filter($selectors, static fn(int $count): bool => $count > 1)),
    'duplicate_selector_list_entries' => $duplicateSelectorListEntries,
    'factorable_route_scope_groups' => $factorableRouteScopeGroups,
    'noncanonical_pagehead_action_inputs' => substr_count($php, 'cmdlike') + substr_count($renderer, 'actionFragment') + substr_count($renderer, 'private const LEGACY'),
    'noncanonical_pagehead_css_tokens' => substr_count($css, '.pagehead-actions') + substr_count($css, '.pagehead-operations') + substr_count($css, '.operation-chip'),
    'noncanonical_pagehead_js_tokens' => substr_count($js, '.pagehead-actions'),
    'noncanonical_pagehead_alias_tokens' => substr_count($css, '--pt-pagehead-action-'),
    'canonical_control_css_rules' => substr_count($css, '.pagehead-control{min-height:var(--pt-pagehead-control-height)'),
    'canonical_primary_css_rules' => substr_count($css, '.pagehead-control--primary{'),
    'canonical_secondary_css_rules' => substr_count($css, '.pagehead-control--secondary{'),
    'canonical_nav_css_rules' => substr_count($css, '.pagehead-control--nav{background:transparent;color:var(--pt-pagehead-control-accent);border-color:transparent}'),
    'canonical_danger_css_rules' => substr_count($css, '.pagehead-control--danger{'),
    'canonical_renderer_runtime_calls' => substr_count($rt2, 'PageHeadControlPresentationOperations01::link') + substr_count($rt3, 'PageHeadControlPresentationOperations01::pageHead'),
    'renderer_lines' => $renderer !== '' ? substr_count($renderer, "\n") + 1 : 0,
    'runtime03_lines' => substr_count($rt3, "\n") + 1,
    'runtime03_dead_operation_menu' => substr_count($rt3, 'operation_menu_html') + substr_count($rt3, '"__menu"'),
    'route_pagehead_identity_overrides' => $routeOverrides,
];
$failures = [];
$exact = (array) ($contract['exact'] ?? []);
foreach ($exact as $metric => $expected) {
    if (!array_key_exists($metric, $metrics) || $metrics[$metric] !== $expected) {
        $failures[] = ['rule' => 'exact_metric', 'metric' => $metric, 'expected' => $expected, 'current' => $metrics[$metric] ?? null];
    }
}
$max = (array) ($contract['debt_budget'] ?? []);
foreach ($max as $metric => $limit) {
    if (!array_key_exists($metric, $metrics) || (int) $metrics[$metric] > (int) $limit) {
        $failures[] = ['rule' => 'budget', 'metric' => $metric, 'limit' => $limit, 'current' => $metrics[$metric] ?? null];
    }
}
foreach ([
    '--pt-pagehead-control-height:38px',
    '--pt-pagehead-control-mobile-height:42px',
    '--pt-pagehead-control-radius:var(--md-sys-shape-corner-large)',
    '.pagehead-control--primary{',
    '.pagehead-control--secondary{',
    '.pagehead-control--nav{',
    '.pagehead-control--danger{',
] as $needle) {
    if (!str_contains($css, $needle)) {
        $failures[] = ['rule' => 'canonical_css_missing', 'needle' => $needle];
    }
}
foreach (["private const ROLES = ['nav', 'primary', 'secondary', 'danger'];", 'pagehead-control', 'pageHead'] as $needle) {
    if (!str_contains($renderer, $needle)) {
        $failures[] = ['rule' => 'renderer_missing', 'needle' => $needle];
    }
}
if (substr_count($rt3, 'pagehead-controls pagehead-controls--navigation') !== 1) {
    $failures[] = ['rule' => 'navigation_renderer_owner'];
}
foreach ([
    'developer_clinic_search_html',
    'class="patient-search-bar"',
    'class="patient-filter-chips ds-filter-list-chips"',
    'class="patient-directory-list ds-person-list ds-patient-list"',
    'class="patient-card-row ds-person-row ds-patient-row',
    'class="patient-card-actions ds-person-actions"',
] as $needle) {
    if (!str_contains($adminClinicsPresentation, $needle)) {
        $failures[] = ['rule' => 'admin_clinics_patient_layout_missing', 'needle' => $needle];
    }
}
$adminClinicsDirectoryStart = strpos($adminClinicsPresentation, 'public static function developer_clinic_directory_html(');
$adminClinicsDirectoryEnd = $adminClinicsDirectoryStart === false
    ? false
    : strpos($adminClinicsPresentation, 'public static function developer_administration_tools_html(', $adminClinicsDirectoryStart);
if ($adminClinicsDirectoryStart === false || $adminClinicsDirectoryEnd === false) {
    $failures[] = ['rule' => 'admin_clinics_directory_section_missing'];
} else {
    $adminClinicsDirectory = substr(
        $adminClinicsPresentation,
        $adminClinicsDirectoryStart,
        $adminClinicsDirectoryEnd - $adminClinicsDirectoryStart,
    );
    foreach (['Mais opções', 'developer-advanced-tools', 'admin_operations'] as $needle) {
        if (str_contains($adminClinicsDirectory, $needle)) {
            $failures[] = ['rule' => 'admin_clinics_footer_action_present', 'needle' => $needle];
        }
    }
}
foreach ([
    'patient-directory-overview kpis kpi-info-strip',
    'patient-search-card ds-search-card',
    'patient-list-card patient-directory-card ds-filter-list-block',
] as $needle) {
    if (!str_contains($adminClinicsRuntime, $needle)) {
        $failures[] = ['rule' => 'admin_clinics_patient_composition_missing', 'needle' => $needle];
    }
}
foreach ([
    'admin_health',
    'admin_errors',
    'admin_diagnostics',
    'admin_integrity',
    'admin_security',
    'admin_deleted',
] as $removedDeveloperRoute) {
    if (str_contains($php, $removedDeveloperRoute)) {
        $failures[] = [
            'rule' => 'developer_reliability_route_present',
            'route' => $removedDeveloperRoute,
        ];
    }
}
$developerActions = <<<'PHP'
const PRONTOO_ADMIN_ACTIONS = [
    "admin_performance" => ["label" => "Métricas", "icon" => "monitoring"],
    "admin_clinics" => ["label" => "Consultórios", "icon" => "home_health"],
    "admin_administration" => ["label" => "Administração", "icon" => "tune"],
];
PHP;
if (!str_contains($applicationRoot, $developerActions)) {
    $failures[] = ['rule' => 'developer_navigation_order_or_label'];
}
foreach (['admin_painel', 'HealthEvidence', 'HealthCanary'] as $obsoleteDeveloperFeature) {
    if (str_contains($php, $obsoleteDeveloperFeature)) {
        $failures[] = ['rule' => 'obsolete_developer_feature_present', 'feature' => $obsoleteDeveloperFeature];
    }
}
if (str_contains($maestroCron, 'health_canary')) {
    $failures[] = ['rule' => 'background_health_canary_present'];
}
$result = [
    'ok' => $failures === [],
    'policy' => (string) ($contract['policy'] ?? ''),
    'version' => (string) ($contract['version'] ?? ''),
    'metrics' => $metrics,
    'failures' => $failures,
];
fwrite($failures === [] ? STDOUT : STDERR, json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . PHP_EOL);
exit($failures === [] ? 0 : 1);
