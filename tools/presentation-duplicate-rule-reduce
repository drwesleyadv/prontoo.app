#!/usr/bin/env python3
from __future__ import annotations
import hashlib
import json
from pathlib import Path
import re
import tinycss2

ROOT = Path(__file__).resolve().parents[1]
STYLE_ROOT = ROOT / 'app/Presentation/Styles'
MANIFEST_PATH = STYLE_ROOT / 'styles.manifest.json'
ARTIFACT_PATH = ROOT / 'public/assets/presentation.css'
VISUAL_PATH = ROOT / 'app/presentation.visual-contract.json'
VERSION_PATH = ROOT / 'version.json'
RULE_LIST_AT = {'media','supports','container','layer','scope','starting-style'}


def fail(message: str) -> None:
    raise SystemExit(f'presentation-duplicate-rule-reduce: {message}')


def line_offsets(source: str) -> list[int]:
    offsets=[0]
    for index,char in enumerate(source):
        if char == '\n': offsets.append(index+1)
    return offsets


def offset_for(node, offsets: list[int]) -> int:
    line=max(1,int(getattr(node,'source_line',1)))
    column=max(1,int(getattr(node,'source_column',1)))
    return offsets[min(line-1,len(offsets)-1)] + column - 1


def normalize_selector(tokens) -> str:
    return ' '.join(tinycss2.serialize(tokens).split())


def collect(rules, context, rows, offsets, source):
    for rule in rules:
        if rule.type == 'qualified-rule':
            raw=tinycss2.serialize([rule])
            start=offset_for(rule,offsets)
            if source[start:start+len(raw)] != raw:
                fail(f'raw rule source mismatch at {start}: {normalize_selector(rule.prelude)}')
            body=tinycss2.serialize(rule.content)
            rows.append({
                'context':tuple(context),
                'selector':normalize_selector(rule.prelude),
                'body':body,
                'raw':raw,
                'start':start,
                'end':start+len(raw),
                'important':body.count('!important'),
                'route_scopes':normalize_selector(rule.prelude).count('body[data-route='),
            })
        elif rule.type == 'at-rule' and rule.content is not None and str(rule.lower_at_keyword) in RULE_LIST_AT:
            prelude=' '.join(tinycss2.serialize(rule.prelude).split())
            inner=tinycss2.parse_rule_list(rule.content,skip_whitespace=False,skip_comments=False)
            collect(inner,context+((str(rule.lower_at_keyword),prelude),),rows,offsets,source)


def duplicate_selector_headers(css: str) -> int:
    selectors={}
    for match in re.finditer(r'([^{}]+)\{([^{}]*)\}',css):
        selector=re.sub(r'\s+',' ',match.group(1).strip())
        if selector and not selector.startswith('@'):
            selectors[selector]=selectors.get(selector,0)+1
    return sum(1 for count in selectors.values() if count>1)


def metrics(css: str) -> dict[str,int]:
    return {
        'css_lines':css.count('\n')+1,
        'css_nonblank_lines':sum(1 for line in css.splitlines() if line.strip()),
        'css_bytes':len(css.encode()),
        'important_count':css.count('!important'),
        'route_scope_count':css.count('body[data-route='),
        'duplicate_selector_headers':duplicate_selector_headers(css),
        'duplicate_selector_list_entries':0,
        'factorable_route_scope_groups':0,
    }


def main() -> None:
    css=ARTIFACT_PATH.read_text(encoding='utf-8')
    offsets=line_offsets(css)
    rows=[]
    rules=tinycss2.parse_stylesheet(css,skip_whitespace=False,skip_comments=False)
    collect(rules,tuple(),rows,offsets,css)
    last_index={}
    for index,row in enumerate(rows):
        last_index[(row['context'],row['selector'],row['body'])]=index
    removals=[]
    for index,row in enumerate(rows):
        key=(row['context'],row['selector'],row['body'])
        if last_index[key] != index:
            removals.append(row)
    if len(removals) != 5:
        fail(f'exact duplicate rule audit drift: expected 5, got {len(removals)}')
    if sum(row['important'] for row in removals) != 0 or sum(row['route_scopes'] for row in removals) != 0:
        fail('phase is restricted to duplicate rules without important or route scope debt')
    for previous,current in zip(sorted(removals,key=lambda row:row['start']),sorted(removals,key=lambda row:row['start'])[1:]):
        if previous['end'] > current['start']:
            fail('overlapping duplicate rule spans')

    manifest=json.loads(MANIFEST_PATH.read_text(encoding='utf-8'))
    sources=manifest.get('sources') or []
    sequence=manifest.get('sequence') or []
    source_data={item['path']:(STYLE_ROOT/item['path']).read_bytes() for item in sources}
    source_next={path:0 for path in source_data}
    artifact_cursor=0
    owner_buffers={path:bytearray() for path in source_data}
    new_sequence=[]
    removal_hits={row['start']:0 for row in removals}
    removal_by_start={row['start']:row for row in removals}
    removals_sorted=sorted(removals,key=lambda row:row['start'])

    for item in sequence:
        path=item['source']; offset=int(item['offset']); size=int(item['bytes'])
        if offset != source_next[path]: fail('source sequence is not contiguous')
        raw=source_data[path][offset:offset+size]
        if len(raw)!=size or hashlib.sha256(raw).hexdigest()!=item['sha256']: fail('slice drift before duplicate-rule reduction')
        text=raw.decode('utf-8')
        segment_start=artifact_cursor; segment_end=segment_start+len(text)
        local_removals=[]
        for row in removals_sorted:
            if row['start']>=segment_start and row['end']<=segment_end:
                local_removals.append(row)
            elif row['start']<segment_end and row['end']>segment_end:
                fail('duplicate rule crosses semantic sequence segment')
        for row in sorted(local_removals,key=lambda row:row['start'],reverse=True):
            local_start=row['start']-segment_start; local_end=row['end']-segment_start
            if text[local_start:local_end] != row['raw']: fail('local duplicate rule mismatch')
            text=text[:local_start]+text[local_end:]
            removal_hits[row['start']]+=1
        encoded=text.encode('utf-8')
        if encoded:
            new_offset=len(owner_buffers[path]); owner_buffers[path].extend(encoded)
            new_sequence.append({
                'order':len(new_sequence)+1,
                'source':path,
                'offset':new_offset,
                'bytes':len(encoded),
                'sha256':hashlib.sha256(encoded).hexdigest(),
                'important_count':text.count('!important'),
                'route_scope_count':text.count('body[data-route='),
            })
        source_next[path]+=size
        artifact_cursor=segment_end
    if artifact_cursor != len(css): fail('sequence does not cover artifact')
    if any(count!=1 for count in removal_hits.values()): fail(f'duplicate removal coverage drift: {removal_hits}')

    new_css=''.join(bytes(owner_buffers[item['source']])[item['offset']:item['offset']+item['bytes']].decode('utf-8') for item in new_sequence)
    direct=css
    for row in sorted(removals,key=lambda row:row['start'],reverse=True):
        direct=direct[:row['start']]+direct[row['end']:]
    if new_css != direct: fail('semantic owner reconstruction differs from direct exact-rule removals')

    source_meta={item['path']:item for item in sources}; new_sources=[]
    for item in sources:
        path=item['path']; data=bytes(owner_buffers[path]); text=data.decode('utf-8'); (STYLE_ROOT/path).write_bytes(data)
        new_sources.append({
            'path':path,'layer':source_meta[path]['layer'],'responsibility':source_meta[path]['responsibility'],'concern':source_meta[path]['concern'],
            'sha256':hashlib.sha256(data).hexdigest(),'bytes':len(data),'important_count':text.count('!important'),'route_scope_count':text.count('body[data-route='),
        })
    ARTIFACT_PATH.write_text(new_css,encoding='utf-8',newline='')
    before=metrics(css); after=metrics(new_css)
    if after['important_count']!=before['important_count'] or after['route_scope_count']!=before['route_scope_count']:
        fail('unrelated debt metric changed')
    if after['duplicate_selector_headers'] >= before['duplicate_selector_headers']:
        fail('duplicate selector header metric did not improve')
    current_sha=hashlib.sha256(new_css.encode()).hexdigest()
    manifest['artifact_contract']={'sha256':current_sha,'bytes':after['css_bytes'],'lines':after['css_lines'],'deterministic_source_required':True}
    manifest['visual_debt_budget']['important_count_max']=after['important_count']
    manifest['visual_debt_budget']['route_scope_count_max']=after['route_scope_count']
    manifest['visual_debt_budget']['duplicate_selector_headers_max']=after['duplicate_selector_headers']
    manifest['sources']=new_sources; manifest['sequence']=new_sequence; manifest['sequence_segment_count']=len(new_sequence)
    MANIFEST_PATH.write_text(json.dumps(manifest,indent=2,ensure_ascii=False)+'\n',encoding='utf-8')

    visual=json.loads(VISUAL_PATH.read_text(encoding='utf-8'))
    previous=dict(visual['metrics']['after']); final=dict(previous); final.update(after)
    visual['version']='1.8.12.11'
    visual['reference']['previous_release']='1.8.12.10'
    visual['reference']['previous_visual_reference']='route_scope_factorization_v1'
    visual['reference']['visual_reference']='exact_duplicate_rule_elimination_v1'
    visual['reference']['functional_equivalence']='later_identical_rule_retained_in_same_context_plus_computed_style_geometry_baseline_stable'
    visual['metrics']['before']=previous; visual['metrics']['after']=final
    visual['metrics']['delta']={key:final[key]-previous[key] for key in final if isinstance(final.get(key),int) and isinstance(previous.get(key),int)}
    visual['debt_budget']['important_count']=after['important_count']; visual['debt_budget']['route_scope_count']=after['route_scope_count']; visual['debt_budget']['duplicate_selector_headers']=after['duplicate_selector_headers']
    visual['delivery']['current_sha256']=current_sha; visual['delivery']['current_bytes']=after['css_bytes']
    VISUAL_PATH.write_text(json.dumps(visual,indent=4,ensure_ascii=False)+'\n',encoding='utf-8')

    version=json.loads(VERSION_PATH.read_text(encoding='utf-8'))
    version['version']='1.8.12.11'; version['release']='1.8.12.11'; version['build']='1.8.12.11-presentation-exact-duplicate-rule-reduction'; version['previous_version']='1.8.12.10'; version['database_changes']=False; version['schema_changes']=False; version['logic_changes']=True; version['visual_changes']=False; version['functional_equivalence_policy']='remove_earlier_exact_duplicate_rules_keep_later_cascade_winner_and_pinned_ux_baseline'; version['notes']='Cinco regras responsivas exatamente duplicadas do PageHead são removidas em sua ocorrência anterior; a ocorrência posterior vencedora permanece, reduzindo dívida sem alterar UX.'
    VERSION_PATH.write_text(json.dumps(version,indent=4,ensure_ascii=False)+'\n',encoding='utf-8')

    print(json.dumps({
        'ok':True,
        'removed_exact_duplicate_rules':len(removals),
        'removed_important':0,
        'before':before,
        'after':after,
        'byte_delta':after['css_bytes']-before['css_bytes'],
        'line_delta':after['css_lines']-before['css_lines'],
        'sha256':current_sha,
        'sequence_segments':len(new_sequence),
    },indent=2,ensure_ascii=False))

if __name__=='__main__': main()
