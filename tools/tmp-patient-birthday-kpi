#!/usr/bin/env bash
set -euo pipefail

python3 <<'PY'
from pathlib import Path

runtime = Path('app/Runtime/Patients/PatientsRuntimeOperations05.php')
text = runtime.read_text()
replacements = {
    '$incompleteCount = (int) ($directoryStats["incomplete_count"] ?? 0);': '$birthdayCount = (int) ($directoryStats["birthday_count"] ?? 0);',
    '($incompleteCount > 0 ? "is-bad warn" : "is-ok")': '($birthdayCount > 0 ? "is-ok" : "is-muted")',
    'UiComponentsPresentationOperations01::icon("fact_check")': 'UiComponentsPresentationOperations01::icon("cake")',
    'number_format($incompleteCount, 0, ",", ".")': 'number_format($birthdayCount, 0, ",", ".")',
    '"</b><span>Cadastro incompleto</span></p></div></section>";': '"</b><span>Aniversariantes</span></p></div></section>";',
}
for old, new in replacements.items():
    if text.count(old) != 1:
        raise SystemExit(f'Runtime replacement mismatch: {old}')
    text = text.replace(old, new, 1)
runtime.write_text(text)

sql = Path('app/Infrastructure/Operational/PatientsSqlCatalog05.php')
s = sql.read_text()
old = '"(SELECT COUNT(*) FROM pi_patients pp JOIN pi_persons p ON p.id=pp.person_id WHERE pp.clinic_id=? AND pp.active=1 AND ((p.birth_date IS NOT NULL AND p.birth_date>DATE_SUB(CURDATE(), INTERVAL 18 YEAR) AND NOT EXISTS (SELECT 1 FROM pi_patient_guardians pg WHERE pg.clinic_id=pp.clinic_id AND pg.patient_link_id=pp.id AND pg.active=1)) OR COALESCE(pp.phone,\'\')=\'\' OR COALESCE(pp.updated_at,pp.created_at,0)<DATE_SUB(NOW(), INTERVAL 180 DAY))) incomplete_count"'
new = '"(SELECT COUNT(*) FROM pi_patients pp JOIN pi_persons p ON p.id=pp.person_id WHERE pp.clinic_id=? AND pp.active=1 AND p.birth_date IS NOT NULL AND MONTH(p.birth_date)=MONTH(CURDATE()) AND DAY(p.birth_date)=DAY(CURDATE())) birthday_count"'
if s.count(old) != 1:
    raise SystemExit('SQL birthday metric replacement mismatch')
s = s.replace(old, new, 1)
sql.write_text(s)
PY

cat > /tmp/release.json <<'JSON'
{
  "build": "1.9.14.6-patient-birthday-kpi",
  "package_type": "micro_ux",
  "notes": "Substitui o KPI Cadastro incompleto por Aniversariantes na tela de Pacientes, usando o mesmo critério diário do filtro de aniversariantes, sem alterar schema, persistência ou os demais filtros.",
  "logic_changes": true,
  "visual_changes": true,
  "documentation_changes": true,
  "changelog": {
    "title": "KPI Aniversariantes em Pacientes",
    "items": [
      "Substitui o KPI Cadastro incompleto por Aniversariantes na faixa de resumo de Pacientes.",
      "Conta pacientes ativos cujo dia e mês de nascimento coincidem com a data atual.",
      "Reutiliza exatamente o critério diário já aplicado pelo filtro Aniversariantes.",
      "Apresenta o KPI com ícone de bolo e semântica positiva, preservando o mesmo layout.",
      "Mantém inalterados os KPIs Hoje, Essa semana e Desistentes, além dos filtros e permissões existentes.",
      "Não altera schema, persistência, cadastro de pacientes ou limites de consulta."
    ]
  }
}
JSON

STAMP="$(TZ=America/Cuiaba date --iso-8601=seconds)"
php tools/release-version --write --date=2026-09-14 --timestamp="$STAMP" --expected-current=1.9.14.5 --metadata-file=/tmp/release.json

git mv public/assets/app-icon-1.9.14.5.png public/assets/app-icon-1.9.14.6.png
git mv public/assets/favicon-1.9.14.5.ico public/assets/favicon-1.9.14.6.ico
git mv public/assets/favicon-1.9.14.5.png public/assets/favicon-1.9.14.6.png
git mv public/assets/pix-1.9.14.5.svg public/assets/pix-1.9.14.6.svg
git mv public/assets/prontoo-mark-1.9.14.5.png public/assets/prontoo-mark-1.9.14.6.png

git rm -f .github/workflows/tmp-patient-birthday-kpi.yml tools/tmp-patient-birthday-kpi

python3 <<'PY'
import subprocess
from pathlib import Path
try:
    raw = subprocess.check_output(['git', 'grep', '-Ilz', '1.9.14.5'])
except subprocess.CalledProcessError as e:
    raw = e.output or b''
for item in raw.split(b'\0'):
    if not item:
        continue
    p = Path(item.decode())
    try:
        text = p.read_text()
    except UnicodeDecodeError:
        continue
    if '1.9.14.5' in text:
        p.write_text(text.replace('1.9.14.5', '1.9.14.6'))
PY

php tools/presentation-css-build --lint
php tools/presentation-css-build --write
php tools/presentation-css-build --check
php tools/release-contract-reconcile --write
php tools/release-contract-reconcile --check
php tools/release-version
php tools/version-asset-contract-check.php
php tools/superseded-reference-contract-check
php tools/test-fast
GITHUB_BASE_REF=prontoo php tools/runtime-refactor-on-touch-check
php -l app/Runtime/Patients/PatientsRuntimeOperations05.php
php -l app/Infrastructure/Operational/PatientsSqlCatalog05.php
grep -Fq '$birthdayCount = (int) ($directoryStats["birthday_count"] ?? 0);' app/Runtime/Patients/PatientsRuntimeOperations05.php
grep -Fq 'icon("cake")' app/Runtime/Patients/PatientsRuntimeOperations05.php
grep -Fq '<span>Aniversariantes</span>' app/Runtime/Patients/PatientsRuntimeOperations05.php
grep -Fq 'DAY(p.birth_date)=DAY(CURDATE())) birthday_count' app/Infrastructure/Operational/PatientsSqlCatalog05.php
! grep -Fq 'incomplete_count' app/Infrastructure/Operational/PatientsSqlCatalog05.php
git diff --check

