        'ok' => true,
        'policy' => 'canonical-engineering-quality-gate-v1',
        'mode' => 'fast',
        'gates_passed' => $passed,
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . PHP_EOL);
    exit(0);
}

$lint();
$canonical();
$run('version-asset-contract', 'tools/version-asset-contract-check.php');
$run('php84-runtime-contract', 'tools/php84-runtime-contract-check');
$run('release-version-contract', 'tools/release-version');
$run('release-contract', 'tools/release-contract-reconcile', ['--check']);
$run('documentation-contract', 'tools/documentation-check.php');
$run('code-comment-contract', 'tools/code-comment-check.php');
$run('security-regressions', 'tools/security-regression-check.php');
$run('architecture-invariants', 'tools/architecture-check.php');
$run('native-unit-contract', 'tools/native-unit-check');
$run('runtime-symbol-contract', 'tools/runtime-symbol-contract-check');
$run('solid-structural-audit', 'tools/solid-audit', ['--strict']);

